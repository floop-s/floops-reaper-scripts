desc:Floop Chrominator (Stereo Analog Saturator)
// @version 2.1.0
// @author Floop-s
// @license GPL-3.0
// @changelog
//   + Restored V1 saturation tone with new wavefolding protection
//   + Fixed DC thump/pop when engaging Punish
//   + Improved Auto-Gain response under heavy clipping
//   - Removed obsolete HQ button

in_pin: Left
in_pin: Right
out_pin: Left
out_pin: Right

slider1:0<0,4,1{Soft,Even,Clip,Warm,Odd}>Mode
slider2:0<0,10,0.01>Drive
slider3:0<-1,1,0.01>Tone (Tilt)
slider4:100<0,100,0.1>Mix (Wet %)
slider5:0<0,1,1{Off,On}>Punish (+20 dB)
slider6:0<0,2,1{1x,2x,4x}>Oversampling
slider7:20<20,400,1>Low Cut (Hz)
slider8:20000<500,20000,1>High Cut (Hz)
slider9:0<0,1,1{Gentle,Sharp}>High Cut Slope
slider10:0<0,1,1{Off,On}>Bump (Head Bump)
slider11:0<-24,24,0.1>Output (dB)
slider12:1<0,1,1{Off,On}>Auto-Gain
slider14:10<0,250,1>Smoothing (ms)

options:no_meter

@init
tilt_pivot = 1000;
ext_noinit = 1;

UI_SLIDER_MASK = (1<<14)-1;
sliders_showing = slider_show(UI_SLIDER_MASK, 0) > 0;

w_hp_fc = 20;
ag_apply_tau = 0.10;

hc1L = 0; hc1R = 0; hc2L = 0; hc2R = 0; hc3L = 0; hc3R = 0; hc4L = 0; hc4R = 0; hc5L = 0; hc5R = 0;

first_run = 1;

// --- TMT ---
tmt_fc_L = 0.992 + rand()*0.016;
tmt_fc_R = 0.992 + rand()*0.016;
tmt_gain_L = 0.995 + rand()*0.010;
tmt_gain_R = 0.995 + rand()*0.010;

mode = slider1|0;
drive = max(0, slider2);
tone = slider3;
mix = slider4/100;
punish = slider5|0;
os_sel = slider6|0;
os_factor = (os_sel==0)?1:(os_sel==1)?2:4;
sys_srate = srate * os_factor;
prev_sys_srate = sys_srate;

lc_freq = max(20, slider7);
hc_freq = min(slider8, srate*0.49);
sharp_slope = slider9|0;
thump_on = slider10|0;
out_db = slider11;
ag_on = slider12|0;
sm_ms = slider14;

tiny_guard = 10^(-12); 
tiny_denorm = 10^(-24); 
function denorm_protect(x) ( abs(x) < tiny_denorm ? 0 : x );

// SVF TPT
function svf_set(freq, Q) instance(g, k, a1, a2, a3) (
  g = tan($pi * freq / sys_srate);
  k = 1.0 / Q;
  a1 = 1.0 / (1.0 + g * (g + k));
  a2 = g * a1;
  a3 = g * a2;
);
function svf_hp(x) instance(g, k, a1, a2, a3, ic1, ic2) local(v3, v1, v2) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2.0 * v1 - ic1; ic2 = 2.0 * v2 - ic2;
  x - k * v1 - v2;
);
function svf_lp(x) instance(g, k, a1, a2, a3, ic1, ic2) local(v3, v1, v2) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2.0 * v1 - ic1; ic2 = 2.0 * v2 - ic2;
  v2;
);
function svf_bp(x) instance(g, k, a1, a2, a3, ic1, ic2) local(v3, v1, v2) (
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2.0 * v1 - ic1; ic2 = 2.0 * v2 - ic2;
  v1;
);

// 1-Pole TPT
function tpt1_set(freq) instance(g) ( g = tan($pi * freq / sys_srate); );
function tpt1_lp(x) instance(g, ic) local(v, lp) (
  v = (x - ic) * g / (1.0 + g); lp = v + ic; ic = lp + v;
  lp;
);
function tpt1_hp(x) instance(g, ic) local(v, lp) (
  v = (x - ic) * g / (1.0 + g); lp = v + ic; ic = lp + v;
  x - lp;
);

// POLYPHASE IIR OVERSAMPLING
function ap(x, c) instance(z) local(y) (
  y = c * x + z; z = x - c * y; y;
);
function os_up_2x(x) instance(a0,a1,a2, a3,a4,a5) local(y0, y1) (
  y0 = a0.ap(x, 0.032533036814);
  y0 = a1.ap(y0, 0.315998188001);
  y0 = a2.ap(y0, 0.760143834015);
  y1 = a3.ap(x, 0.144414324838);
  y1 = a4.ap(y1, 0.536979685651);
  y1 = a5.ap(y1, 0.932974441223);
  this.out0 = y0; this.out1 = y1;
);
function os_down_2x(s0, s1) instance(a0,a1,a2, a3,a4,a5, prev_s1) local(y0, y1) (
  y0 = a0.ap(s0, 0.032533036814);
  y0 = a1.ap(y0, 0.315998188001);
  y0 = a2.ap(y0, 0.760143834015);
  y1 = a3.ap(prev_s1, 0.144414324838);
  y1 = a4.ap(y1, 0.536979685651);
  y1 = a5.ap(y1, 0.932974441223);
  prev_s1 = s1;
  0.5 * (y0 + y1);
);
function os_up_4x(x) instance(up1, up2, up3) (
  up1.os_up_2x(x);
  up2.os_up_2x(up1.out0); this.out0 = up2.out0; this.out1 = up2.out1;
  up3.os_up_2x(up1.out1); this.out2 = up3.out0; this.out3 = up3.out1;
);
function os_down_4x(s0, s1, s2, s3) instance(dn1, dn2, dn3) local(d0, d1) (
  d0 = dn1.os_down_2x(s0, s1);
  d1 = dn2.os_down_2x(s2, s3);
  dn3.os_down_2x(d0, d1);
);

// SATURATION MODELS
function saturate_soft(x) (
  // Mode 0: Smooth tape-style saturation (Pure tanh)
  x = min(8, max(-8, x));
  (exp(2*x) - 1) / (exp(2*x) + 1);
);

function saturate_even(x) local(y, e) (
  // Mode 1: Asymmetric clipping, 2nd harmonic richness
  x = min(8, max(-8, x));
  y = x + 0.5;
  e = exp(2*y);
  y = (e - 1) / (e + 1);
  (y - 0.462117) * 1.265;
);

function saturate_clip(x) local(y) (
  // Mode 2: Gritty, slightly asymmetric clipping
  x = min(8, max(-8, x));
  y = x + 0.2;
  y = y / sqrt(1.0 + y * y);
  (y - 0.196116) * 1.05;
);

function saturate_warm(x) (
  // Mode 3: Tube-style massive even harmonics
  x = min(8, max(-8, x));
  x > 0 ? ( x / (1.0 + 1.2 * x) ) : ( x / (1.0 - 0.6 * x) );
);

function saturate_odd(x) local(y, e) (
  // Mode 4: Aggressive, perfectly symmetric, pure odd harmonics
  x = min(6, max(-6, x));
  y = x + 0.1 * x * x * x;
  e = exp(2*y);
  (e - 1) / (e + 1);
);

function reset_audio_states() ( 
  lc1L.ic1 = lc1L.ic2 = lc1R.ic1 = lc1R.ic2 = 0;
  lc2L.ic1 = lc2L.ic2 = lc2R.ic1 = lc2R.ic2 = 0;
  hc1L.ic1 = hc1L.ic2 = hc1R.ic1 = hc1R.ic2 = 0;
  hc2L.ic1 = hc2L.ic2 = hc2R.ic1 = hc2R.ic2 = 0;
  thL.ic1 = thL.ic2 = thR.ic1 = thR.ic2 = 0;
  
  tiltL.ic = tiltR.ic = 0;
  preAL.ic = preAR.ic = 0;
  postEL.ic = postER.ic = 0;
  postNL.ic = postNR.ic = 0;
  oddL.ic = oddR.ic = 0;
  
  w_out_lpL = w_out_lpR = 0;
  out_prevL = out_prevR = 0; 
  out_oldL = out_oldR = 0;
  ag_smooth = 1; ag_apply_state = 1; 
  first_run = 1; 
); 
reset_audio_states();



function update_filters() (
  tiltL.tpt1_set(tilt_pivot * tmt_fc_L); tiltR.tpt1_set(tilt_pivot * tmt_fc_R);
  lc1L.svf_set(lc_freq * tmt_fc_L, 0.7071); lc1R.svf_set(lc_freq * tmt_fc_R, 0.7071);
  lc2L.svf_set(lc_freq * tmt_fc_L, 0.7071); lc2R.svf_set(lc_freq * tmt_fc_R, 0.7071);
  hc1L.svf_set(hc_freq * tmt_fc_L, 0.7071); hc1R.svf_set(hc_freq * tmt_fc_R, 0.7071);
  hc2L.svf_set(hc_freq * tmt_fc_L, 0.7071); hc2R.svf_set(hc_freq * tmt_fc_R, 0.7071);
  th_freq = lc_freq > 20 ? lc_freq : 60;
  thL.svf_set(th_freq * tmt_fc_L, 1.5); thR.svf_set(th_freq * tmt_fc_R, 1.5);

  preA_fc = 60; preA_gain = 10^(2/20);
  preAL.tpt1_set(preA_fc); preAR.tpt1_set(preA_fc);
  postE_fc = 10000; postE_gain = 10^(0.5/20);
  postEL.tpt1_set(postE_fc); postER.tpt1_set(postE_fc);
  postN_fc = 3500; postN_gain = 10^(3/20);
  postNL.tpt1_set(postN_fc); postNR.tpt1_set(postN_fc);
  
  odd_hp_fc = 40;
  oddL.tpt1_set(odd_hp_fc); oddR.tpt1_set(odd_hp_fc);
);

function update_srate_coeffs() (
  sm_on = sm_ms > 0;
  sm_tau = sm_on ? (sm_ms/1000) : 0.005; // 5ms minimum to avoid zipper
  sm_a = sm_on ? exp(-1/(sm_tau*srate)) : 0;
  sm_alpha = 1 - sm_a;
  
  punish_tau = 0.08; // 80ms dedicated slew-rate for Punish to prevent DC thump
  punish_a = exp(-1/(punish_tau*srate));
  punish_alpha = 1 - punish_a;
  
  w_hp_a = exp(-2*$pi*w_hp_fc/srate); w_hp_alpha = 1 - w_hp_a;
);

// WET/DRY PROCESSING CORE
function process_sample(inL, inR) (
  dryL = inL; dryR = inR;
  wetL = inL; wetR = inR;
  
  // Low Cut
  hpL = lc1L.svf_hp(wetL); hpR = lc1R.svf_hp(wetR);
  sharp_slope ? ( hpL = lc2L.svf_hp(hpL); hpR = lc2R.svf_hp(hpR); );
  
  // Head Bump
  bumpL = thump_on ? thL.svf_bp(hpL) * (th_gain - 1) : 0;
  bumpR = thump_on ? thR.svf_bp(hpR) * (th_gain - 1) : 0;
  wetL = hpL + bumpL; wetR = hpR + bumpR;
  
  // Pre-emphasis
  pre_lpL = preAL.tpt1_lp(wetL); pre_lpR = preAR.tpt1_lp(wetR);
  mode == 0 ? (
    wetL = pre_lpL*preA_gain + (wetL - pre_lpL);
    wetR = pre_lpR*preA_gain + (wetR - pre_lpR);
  );
  
  // Drive Stage
  xL = wetL * dr_gain_L; xR = wetR * dr_gain_R;
  
  // Saturation Models
  mode == 0 ? ( satL = saturate_soft(xL); satR = saturate_soft(xR); );
  mode == 1 ? ( satL = saturate_even(xL); satR = saturate_even(xR); ); 
  mode == 2 ? ( satL = saturate_clip(xL)*1.5; satR = saturate_clip(xR)*1.5; );
  mode == 3 ? ( satL = saturate_warm(xL); satR = saturate_warm(xR); );
  mode == 4 ? ( 
    xLh = xL - oddL.tpt1_lp(xL); xRh = xR - oddR.tpt1_lp(xR);
    satL = saturate_odd(xLh); satR = saturate_odd(xRh);
  );
  
  wetL = satL; wetR = satR;
  
  // Post-emphasis
  pstE_lpL = postEL.tpt1_lp(wetL); pstE_lpR = postER.tpt1_lp(wetR);
  pstN_lpL = postNL.tpt1_lp(wetL); pstN_lpR = postNR.tpt1_lp(wetR);
  
  mode == 1 ? (
    wetL = pstE_lpL + (wetL - pstE_lpL)*postE_gain;
    wetR = pstE_lpR + (wetR - pstE_lpR)*postE_gain;
  );
  mode == 2 ? (
    wetL = pstN_lpL + (wetL - pstN_lpL)*postN_gain;
    wetR = pstN_lpR + (wetR - pstN_lpR)*postN_gain;
  );
  
  // Tone (Tilt EQ)
  tilt_lpL = tiltL.tpt1_lp(wetL); tilt_lpR = tiltR.tpt1_lp(wetR);
  tilt_highL = wetL - tilt_lpL; tilt_highR = wetR - tilt_lpR;
  wetL = tilt_lpL*low_g + tilt_highL*high_g;
  wetR = tilt_lpR*low_g + tilt_highR*high_g;
  
  // High Cut
  wetL = hc1L.svf_lp(wetL); wetR = hc1R.svf_lp(wetR);
  sharp_slope ? ( wetL = hc2L.svf_lp(wetL); wetR = hc2R.svf_lp(wetR); );
  
  // Mix Dry/Wet
  outL = mix_s * wetL + (1 - mix_s) * dryL;
  outR = mix_s * wetR + (1 - mix_s) * dryR;
);

@slider
mode = slider1|0;
drive = max(0, slider2);
tone = slider3;
mix = slider4/100;
punish = slider5|0;
os_sel = slider6|0;
os_factor = (os_sel==0)?1:(os_sel==1)?2:4;
sys_srate = srate * os_factor;

lc_freq = max(20, slider7);
hc_freq = min(slider8, srate*0.49);
sharp_slope = slider9|0;
thump_on = slider10|0;
out_db = slider11;
ag_on = slider12|0;
sm_ms = slider14;

update_filters();
srate > 0 ? update_srate_coeffs();

xf_ms = max(0.005, min(0.050, 0.5*sm_ms/1000));
drive_s = drive;
tone_s = tone;
mix_s = mix;
out_lin_target = 10^(out_db / 20);
out_lin_s = out_lin_target;
pre_gain_target = punish ? 10^(20/20) : 1;
pre_gain_s = pre_gain_target;


@sample
drive_s = drive_s*sm_a + drive*sm_alpha;
tone_s = tone_s*sm_a + tone*sm_alpha;
mix_s = mix_s*sm_a + mix*sm_alpha;
out_lin_target = 10^(out_db / 20);
out_lin_s = out_lin_s*sm_a + out_lin_target*sm_alpha;

punish = slider5|0;
pre_gain_target = punish ? 10^(20/20) : 1;
pre_gain_s = pre_gain_s*punish_a + pre_gain_target*punish_alpha;
thump_on = slider10|0;
sharp_slope = slider9|0;
lc_freq = max(20, slider7);
hc_freq = min(slider8, srate*0.49);
mode = slider1|0;
os_sel = slider6|0;
ag_on = slider12|0;
os_factor = (os_sel==0)?1:(os_sel==1)?2:4;
sys_srate = srate * os_factor;

chg_srate = (prev_sys_srate != sys_srate);
chg_srate ? ( update_srate_coeffs(); );

chg = chg_srate || (prev_lc_freq != lc_freq) || (prev_hc_freq != hc_freq);
chg ? ( update_filters(); );

chg_fade = (prev_thump_on != thump_on) || (prev_sharp_slope != sharp_slope) || (prev_mode != mode) || (prev_sys_srate != sys_srate);
chg_fade ? (
  out_oldL = out_prevL; out_oldR = out_prevR;
  xf_pos = 0; xf_len = max(1, floor(xf_ms*srate));
  prev_thump_on = thump_on;
  prev_sharp_slope = sharp_slope;
  prev_mode = mode;
  prev_sys_srate = sys_srate;
);
prev_lc_freq = lc_freq;
prev_hc_freq = hc_freq;

// DRIVE CALCULATION (Exponential)
// Maps drive [0,10] to [0, 35] dB boost
dr_gain = pre_gain_s * (10^( (drive_s * 3.5) / 20 )); 
dr_gain_L = dr_gain * tmt_gain_L;
dr_gain_R = dr_gain * tmt_gain_R;

th_gain = thump_on ? 10^(3/20) : 1;
low_g = 1 - tone_s; high_g = 1 + tone_s;

// OVERSAMPLING & PROCESSING
os_sel == 0 ? (
  process_sample(spl0, spl1);
) : os_sel == 1 ? (
  up2x_L.os_up_2x(spl0); up2x_R.os_up_2x(spl1);
  process_sample(up2x_L.out0, up2x_R.out0); yL0 = outL; yR0 = outR;
  process_sample(up2x_L.out1, up2x_R.out1); yL1 = outL; yR1 = outR;
  outL = dn2x_L.os_down_2x(yL0, yL1); outR = dn2x_R.os_down_2x(yR0, yR1);
) : (
  up4x_L.os_up_4x(spl0); up4x_R.os_up_4x(spl1);
  process_sample(up4x_L.out0, up4x_R.out0); yL0 = outL; yR0 = outR;
  process_sample(up4x_L.out1, up4x_R.out1); yL1 = outL; yR1 = outR;
  process_sample(up4x_L.out2, up4x_R.out2); yL2 = outL; yR2 = outR;
  process_sample(up4x_L.out3, up4x_R.out3); yL3 = outL; yR3 = outR;
  outL = dn4x_L.os_down_4x(yL0, yL1, yL2, yL3); outR = dn4x_R.os_down_4x(yR0, yR1, yR2, yR3);
);

// Auto-Gain
target_ag = 1.0 / (dr_gain ^ 0.15); 
target_ag = min(2.0, max(0.2, target_ag));

ag_target_apply = ag_on ? target_ag : 1; 
ag_apply_state = ag_apply_state * sm_a + ag_target_apply * sm_alpha; 

outL *= ag_apply_state; outR *= ag_apply_state;

// CROSSFADE
xf_len > 0 && xf_pos < xf_len ? (
  x = xf_pos/xf_len;
  outL = out_oldL * (1-x) + outL * x; 
  outR = out_oldR * (1-x) + outR * x;
  xf_pos += 1;
);

// DC BLOCKER
w_out_lpL = w_out_lpL*w_hp_a + outL*w_hp_alpha; w_out_lpL = denorm_protect(w_out_lpL); outL = outL - w_out_lpL;
w_out_lpR = w_out_lpR*w_hp_a + outR*w_hp_alpha; w_out_lpR = denorm_protect(w_out_lpR); outR = outR - w_out_lpR;

spl0 = min(0.999, max(-0.999, outL * out_lin_s)); 
spl1 = min(0.999, max(-0.999, outR * out_lin_s));

out_prevL = outL; out_prevR = outR;

@gfx 760 300
// setup input
mx = mouse_x; my = mouse_y; mc = mouse_cap;
clicked = (mc & 1) && !(prev_mc & 1);
released = !(mc & 1) && (prev_mc & 1);
rclicked = (mc & 2) && !(prev_mc & 2);
prev_mc = mc;
mode = slider1|0;
drive = max(0, slider2);
tone = slider3;
mix = slider4/100;
out_db = slider11;
ag_on = slider12|0;

gfx_r = 0.12; gfx_g = 0.12; gfx_b = 0.13; gfx_a = 1; gfx_rect(0,0,gfx_w,gfx_h);
gfx_r = 1; gfx_g = 1; gfx_b = 1;

function clampv(v,mn,mx) ( v<mn ? mn : v>mx ? mx : v );

function draw_thick_arc(x, y, r, a_start, a_end, thickness) local(a, a_step, px, py, nx, ny, t, r_t) (
  a_step = $pi / 32; 
  t = 0;
  while(t < thickness) (
    r_t = r - t;
    a = a_start;
    px = x + cos(a)*r_t; py = y + sin(a)*r_t;
    while (a < a_end) (
      a += a_step;
      a > a_end ? a = a_end;
      nx = x + cos(a)*r_t; ny = y + sin(a)*r_t;
      gfx_line(px, py, nx, ny);
      px = nx; py = ny;
    );
    t += 0.5;
  );
);

function draw_ring(x,y,r,ang_norm,center_top,is_drive)
(
  gfx_a = 1; 
  ring_t = 6; 
  
  gfx_r=0.08; gfx_g=0.08; gfx_b=0.09; gfx_circle(x,y,r,1);
  gfx_r=0.12; gfx_g=0.12; gfx_b=0.13; gfx_circle(x,y,r-ring_t,1);
  
  start_a = $pi * 0.75;
  sweep_a = $pi * 1.5;
  ring_a = center_top ? (-$pi/2 + sweep_a * (ang_norm - 0.5)) : (start_a + sweep_a * ang_norm); 
  
  gfx_r=0.18; gfx_g=0.18; gfx_b=0.20; 
  draw_thick_arc(x, y, r, start_a, start_a + sweep_a, ring_t);
  
  is_drive ? (gfx_r=0.90; gfx_g=0.55; gfx_b=0.15;) : (gfx_r=0.14; gfx_g=0.62; gfx_b=0.32;);
  center_top ? (
    ang_norm > 0.5 ? draw_thick_arc(x, y, r, -$pi/2, ring_a, ring_t) 
                   : draw_thick_arc(x, y, r, ring_a, -$pi/2, ring_t);
  ) : (
    draw_thick_arc(x, y, r, start_a, ring_a, ring_t);
  );

  notch_ri = r - ring_t - 3; notch_ro = r - 1; 
  ring_px = -sin(ring_a); ring_py = cos(ring_a);  
  gfx_r=1; gfx_g=1; gfx_b=1;
  notch_i=-1; while(notch_i<=1)( 
    x1 = floor(x + cos(ring_a)*notch_ri + ring_px*notch_i + 0.5);
    y1 = floor(y + sin(ring_a)*notch_ri + ring_py*notch_i + 0.5);
    x2 = floor(x + cos(ring_a)*notch_ro + ring_px*notch_i + 0.5);
    y2 = floor(y + sin(ring_a)*notch_ro + ring_py*notch_i + 0.5);
    gfx_line(x1,y1,x2,y2);
    notch_i += 1;
  );
);

function knob(id,x,y,r,label,val,vmin,vmax,unit,slider_idx,center_top,is_drive)
(
  norm = (val - vmin)/(vmax - vmin);
  draw_ring(x,y,r,norm,center_top,is_drive);
  gfx_a = 1;
  ring_t2 = 6; gap_g = 5; 
  center_r = r - (ring_t2 + gap_g); 
  gfx_r=0.15; gfx_g=0.15; gfx_b=0.16; gfx_circle(x,y,center_r,1);
  gfx_r=0.20; gfx_g=0.20; gfx_b=0.22; gfx_circle(x,y,center_r,0);
  
  gfx_r=0.60; gfx_g=0.60; gfx_b=0.62; 
  gfx_measurestr(label, lab_w, lab_h); gfx_x = x - lab_w/2; gfx_y = y + r + 8; gfx_printf(label);
  
  val_oy = floor(34*(r/34) + 0.5); 
  (slider_idx==7 || slider_idx==8) ? (
    sprintf(#val_str, "%d %s", floor(val+0.5), unit);
  ) : (slider_idx==4) ? (
    sprintf(#val_str, "%d%%", floor(val+0.5));
  ) : (slider_idx==11) ? (
    sprintf(#val_str, "%.1f %s", val, unit);
  ) : (slider_idx==14) ? (
    sprintf(#val_str, "%d %s", floor(val+0.5), unit);
  ) : (
    sprintf(#val_str, "%.2f %s", val, unit);
  );
  gfx_measurestr(#val_str, val_w, val_h);
  gfx_r=0.9; gfx_g=0.9; gfx_b=0.9;
  gfx_x = x - val_w/2; gfx_y = y + r + val_oy; gfx_printf("%s", #val_str);
  
  dx = mx - x; dy = my - y; dist = sqrt(dx*dx + dy*dy);
  inside = dist <= (r + 8);
  hover = inside && !(mc & 1);
  hover ? ( gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=0.1; gfx_circle(x,y,r-18,1); gfx_a=1; );
  ((clicked && inside) || ((mc & 1) && inside && drag_id == -1)) ? (
    drag_id = id; drag_slider = slider_idx; drag_start_y = my; drag_start_val = val;
  );
  rclicked && inside ? (
    slider_idx==2 ? (slider2=0; sliderchange(1));
    slider_idx==3 ? (slider3=0; sliderchange(2));
    slider_idx==4 ? (slider4=100; sliderchange(3)); 
    slider_idx==7 ? (slider7=20; sliderchange(6));
    slider_idx==8 ? (slider8=20000; sliderchange(7));
    slider_idx==11 ? (slider11=0; sliderchange(10));
    slider_idx==14 ? (slider14=10; sliderchange(13));
  );
  (mc & 1) && drag_id == id ? (
    sens = 0.004; 
    delta = (drag_start_y - my) * (vmax - vmin) * sens;
    newv = clampv(drag_start_val + delta, vmin, vmax);
    slider_idx==2 ? (slider2=newv; sliderchange(1));
    slider_idx==3 ? (slider3=newv; sliderchange(2));
    slider_idx==4 ? (slider4=newv; sliderchange(3));
    slider_idx==7 ? (slider7=newv; sliderchange(6));
    slider_idx==8 ? (slider8=newv; sliderchange(7));
    slider_idx==11 ? (slider11=newv; sliderchange(10));
    slider_idx==14 ? (slider14=newv; sliderchange(13));
  );
  released && drag_id == id ? (drag_id = -1;);
);

function button(x,y,w,h,label,state,is_drive)
(
  hover = mx>=x && mx<=x+w && my>=y && my<=y+h;
  state ? (
    is_drive ? (gfx_r=0.90; gfx_g=0.55; gfx_b=0.15;) : (gfx_r=0.14; gfx_g=0.62; gfx_b=0.32;);
  ) : (
    gfx_r=0.18; gfx_g=0.18; gfx_b=0.20; 
  );
  hover && !state ? (gfx_r+=0.04; gfx_g+=0.04; gfx_b+=0.04;);
  hover && state ? (gfx_r+=0.08; gfx_g+=0.08; gfx_b+=0.08;);
  
  gfx_rect(x,y,w,h);
  gfx_r=0.10; gfx_g=0.10; gfx_b=0.11; gfx_rect(x,y,w,1); gfx_rect(x,y+h-1,w,1); gfx_rect(x,y,1,h); gfx_rect(x+w-1,y,1,h);
  
  gfx_r = state?0.05:0.85; gfx_g = state?0.05:0.85; gfx_b = state?0.05:0.85;
  gfx_measurestr(label, lab_w, lab_h);
  gfx_x = x + (w - lab_w)/2;
  gfx_y = y + (h - lab_h)/2;
  gfx_printf(label);
  (clicked && hover) ? 1 : 0;
);

gfx_r = 0.18; gfx_g = 0.18; gfx_b = 0.20; gfx_rect(0,0,gfx_w,26); 
gfx_r = 0.92; gfx_g = 0.92; gfx_b = 0.92; gfx_setfont(1, "Arial", 15);
gfx_measurestr("Floop Chrominator", tw, th);
gfx_x = (gfx_w - tw)/2; gfx_y = (26 - th)/2;
gfx_printf("Floop Chrominator");

btn_ui_w = 20; btn_ui_h = 18;
btn_ui_x = gfx_w - 8 - btn_ui_w; btn_ui_y = 4;
hover_c = mx >= btn_ui_x && mx <= btn_ui_x+btn_ui_w && my >= btn_ui_y && my <= btn_ui_y+btn_ui_h;
clicked_c = hover_c && clicked;
clicked_c ? ( sliders_showing = slider_show(UI_SLIDER_MASK, -1) > 0; );
gfx_r=0.06; gfx_g=0.06; gfx_b=0.07; gfx_rect(btn_ui_x, btn_ui_y, btn_ui_w, btn_ui_h);
gfx_r=0.35; gfx_g=0.35; gfx_b=0.38; gfx_rect(btn_ui_x, btn_ui_y, btn_ui_w, 1); gfx_rect(btn_ui_x, btn_ui_y+btn_ui_h-1, btn_ui_w, 1); gfx_rect(btn_ui_x, btn_ui_y, 1, btn_ui_h); gfx_rect(btn_ui_x+btn_ui_w-1, btn_ui_y, 1, btn_ui_h);
sliders_showing ? ( gfx_r=0.14; gfx_g=0.62; gfx_b=0.32; ) : ( hover_c ? (gfx_r=0.24; gfx_g=0.24; gfx_b=0.26;) : (gfx_r=0.16; gfx_g=0.16; gfx_b=0.18;) );
gfx_rect(btn_ui_x+1, btn_ui_y+1, btn_ui_w-2, btn_ui_h-2);
sliders_showing ? (gfx_r=0.98; gfx_g=0.98; gfx_b=0.98;) : (gfx_r=0.90; gfx_g=0.90; gfx_b=0.90;);
gfx_measurestr("C", cw, ch);
gfx_x = btn_ui_x + (btn_ui_w - cw)/2; gfx_y = btn_ui_y + (btn_ui_h - ch)/2;
gfx_printf("C");

pad=12; scale = (gfx_w/760 < gfx_h/300 ? gfx_w/760 : gfx_h/300); scale = scale<0.8?0.8:scale>3.0?3.0:scale;
sp = floor(8*scale + 0.5);
gap = floor(18*scale + 0.5);
row1y=floor(44*scale + 0.5); row2y=floor(100*scale + 0.5); row3y=floor(188*scale + 0.5);
gfx_setfont(1, "Segoe UI", floor(14*scale + 0.5));
row1y += floor(10*scale + 0.5);
row3y += floor(12*scale + 0.5);
row2y += floor(12*scale + 0.5);

bw=floor(72*scale + 0.5); bh=floor(22*scale + 0.5); totalw = 5*bw + 4*sp; bx = floor((gfx_w - totalw)/2 + 0.5); by=row1y - bh/2;
function mode_btn(ix,label,selected)
(
  xx = bx + ix*(bw+6);
  hover = mx>=xx && mx<=xx+bw && my>=by && my<=by+bh;
  state = selected;
  
  state ? (gfx_r=0.90; gfx_g=0.55; gfx_b=0.15;) : (gfx_r=0.18; gfx_g=0.18; gfx_b=0.20;);
  hover && !state ? (gfx_r+=0.04; gfx_g+=0.04; gfx_b+=0.04;);
  hover && state ? (gfx_r+=0.08; gfx_g+=0.08; gfx_b+=0.08;);
  
  gfx_rect(xx,by,bw,bh);
  gfx_r=0.10; gfx_g=0.10; gfx_b=0.11; gfx_rect(xx,by,bw,1); gfx_rect(xx,by+bh-1,bw,1); gfx_rect(xx,by,1,bh); gfx_rect(xx+bw-1,by,1,bh);
  
  gfx_r = state?0.05:0.85; gfx_g = state?0.05:0.85; gfx_b = state?0.05:0.85;
  gfx_measurestr(label, lab_w, lab_h);
  gfx_x = xx + (bw - lab_w)/2;
  gfx_y = by + (bh - lab_h)/2;
  gfx_printf(label);
  clicked && hover ? (
    slider1=ix; sliderchange(0);
    mode = slider1|0;
  );
);
mode_btn(0,"Soft",mode==0); mode_btn(1,"Even",mode==1); mode_btn(2,"Clip",mode==2); mode_btn(3,"Warm",mode==3); mode_btn(4,"Odd",mode==4);

tw=floor(90*scale + 0.5); th=floor(26*scale + 0.5); totalw = 5*tw + 4*sp; gx = floor((gfx_w - totalw)/2 + 0.5); ty=row2y - th/2;
button(gx,ty,tw,th,"Punish",slider5|0, 1) ? (slider5 = 1 - (slider5|0); sliderchange(4));
gx+=tw+8;
button(gx,ty,tw,th,"Bump",slider10|0, 0) ? (slider10 = 1 - (slider10|0); sliderchange(9));
gx+=tw+8;
button(gx,ty,tw,th,"Sharp",slider9|0, 0) ? (slider9 = 1 - (slider9|0); sliderchange(8));
gx+=tw+8;
button(gx,ty,tw,th,"AutoGain",slider12|0, 0) ? (slider12 = 1 - (slider12|0); sliderchange(11));
gx+=tw+8;
lbl = (slider6==0?"1x":(slider6==1?"2x":"4x"));
button(gx,ty,tw,th,lbl,(slider6|0)>0, 0) ? (
  slider6 = (slider6+1) % 3; sliderchange(5);
);

r=floor(34*scale + 0.5);
totalw = 7*(2*r) + 6*gap; kx = floor((gfx_w - totalw)/2 + 0.5); ky=row3y;
lm = kx; rm = floor(gfx_w - (kx + totalw) + 0.5); adj = floor((rm - lm)/2 + 0.5); kx += adj;
row_mid = kx + floor(totalw/2 + 0.5);
knob(101,kx + r + 0*(2*r+gap),ky,r,"Drive",slider2,0,10,"",2,0, 1);
knob(102,kx + r + 1*(2*r+gap),ky,r,"Tone",slider3,-1,1,"",3,1, 0);
knob(201,kx + r + 2*(2*r+gap),ky,r,"LowCut",slider7,20,400,"Hz",7,0, 0);
knob(202,kx + r + 3*(2*r+gap),ky,r,"HighCut",slider8,500,20000,"Hz",8,0, 0);
knob(103,kx + r + 4*(2*r+gap),ky,r,"Mix",slider4,0,100,"%",4,0, 0);
knob(104,kx + r + 5*(2*r+gap),ky,r,"Output",slider11,-24,24,"dB",11,1, 0);
knob(105,kx + r + 6*(2*r+gap),ky,r,"Smooth",slider14,0,250,"ms",14,0, 0);
