@init

// Floop Master Control - Meter Module (True Peak & LUFS)
// @author Floop-s

// Generate Sinc Coefficients
function sinc_gen_val(slice_pos, sz) local(windowpos, sincpos) (
  windowpos = (2.0 * $pi / sz) * slice_pos;
  sincpos = $pi * (slice_pos - sz * 0.5);
  (0.53836 - cos(windowpos)*0.46164) * (abs(sincpos) < 0.000001 ? 1 : sin(sincpos) / sincpos);
);

function mod_meter_init(slot_id, mem_start, mem_size) local(ptr) (
  ptr = mem_start;
  this.slot_id = slot_id;
  this.mem = mem_start;
  
  this.tp_h = ptr; ptr += 32;
  this.tp_s1 = ptr; ptr += 32;
  this.tp_s2 = ptr; ptr += 32;
  this.tp_s3 = ptr; ptr += 32;
  this.tp_hist_l = ptr; ptr += 32;
  this.tp_hist_r = ptr; ptr += 32;
  
  this.lufs_st_buf = ptr; ptr += 64;
  this.lufs_hist_cnt = ptr; ptr += 1000;
  this.lufs_hist_p = ptr; ptr += 1000;
  
  // Clear buffers
  memset(this.tp_hist_l, 0, 32);
  memset(this.tp_hist_r, 0, 32);
  memset(this.lufs_st_buf, 0, 64);
  memset(this.lufs_hist_cnt, 0, 1000);
  memset(this.lufs_hist_p, 0, 1000);
  
  this.tp_idx = 0;
  this.tp_block_peak = 0;
  this.tp_meter = 0;
  this.tp_max_peak = 0;
  
  this.sinc_sz = 32;
  
  // Constants
  this.inv_log10 = 1/log(10);
  this.gate_abs_p = pow(10, (-70 + 0.691) * 0.1);
  this.denorm = 10^-24;
  
  this.tp_i = 0;
  loop(this.sinc_sz,
    this.tp_s1[this.tp_i] = sinc_gen_val(this.tp_i + 0.25, this.sinc_sz);
    this.tp_s2[this.tp_i] = sinc_gen_val(this.tp_i + 0.50, this.sinc_sz);
    this.tp_s3[this.tp_i] = sinc_gen_val(this.tp_i + 0.75, this.sinc_sz);
    this.tp_i += 1;
  );
  
  this.lufs_srate = 0;
);

function mod_meter_clear_history() (
  this.lufs_st_idx = 0;
  this.lufs_st_filled = 0;
  this.lufs_st_sum = 0;
  this.lufs_st_acc = 0;
  this.lufs_st_n = 0;
  this.lufs_abs_sum = 0;
  this.lufs_abs_count = 0;
  
  memset(this.lufs_hist_cnt, 0, 1000);
  memset(this.lufs_hist_p, 0, 1000);
  memset(this.lufs_st_buf, 0, 64);
  
  this.tp_max_peak = 0;
);

function mod_meter_reset() (
  this.k_hp_d1_l = 0; this.k_hp_d2_l = 0;
  this.k_hp_d1_r = 0; this.k_hp_d2_r = 0;
  this.k_sh_d1_l = 0; this.k_sh_d2_l = 0;
  this.k_sh_d1_r = 0; this.k_sh_d2_r = 0;
  
  memset(this.tp_hist_l, 0, this.sinc_sz);
  memset(this.tp_hist_r, 0, this.sinc_sz);
  this.tp_block_peak = 0;
  
  this.k_hp_x1_l = this.k_hp_x2_l = this.k_hp_y1_l = this.k_hp_y2_l = 0;
  this.k_hp_x1_r = this.k_hp_x2_r = this.k_hp_y1_r = this.k_hp_y2_r = 0;
  this.k_sh_x1_l = this.k_sh_x2_l = this.k_sh_y1_l = this.k_sh_y2_l = 0;
  this.k_sh_x1_r = this.k_sh_x2_r = this.k_sh_y1_r = this.k_sh_y2_r = 0;
);

function mod_meter_block(tp_limit_mode, lufs_s_limit_db) (
  this.lufs_s_limit_db = lufs_s_limit_db;
  this.tp_limit_db =
    tp_limit_mode == 0 ? -1 :
    tp_limit_mode == 1 ? -0.3 : 0;
  
  this.tp_rel = pow(0.99995, samplesblock);
  this.tp_meter *= this.tp_rel;
  this.tp_block_peak > this.tp_meter ? this.tp_meter = this.tp_block_peak;
  this.tp_block_peak = 0;
  
  this.lufs_srate != srate ? (
    this.lufs_srate = srate;
    // LUFS Coefficients (ITU-R BS.1770-4)
    this.db = 3.999843853973347;
    this.f0 = 1681.974450955533;
    this.Q = 0.7071752369554196;
    this.K = tan($pi * this.f0 / this.lufs_srate);
    this.Vh = pow(10, this.db/20);
    this.Vb = pow(this.Vh, 0.4996667741545416);
    this.a0 = 1 + this.K/this.Q + this.K*this.K;
    
    this.k_sh_a1 = 2 * (this.K*this.K - 1) / this.a0;
    this.k_sh_a2 = (1 - this.K/this.Q + this.K*this.K) / this.a0;
    this.k_sh_b0 = (this.Vh + this.Vb*this.K/this.Q + this.K*this.K) / this.a0;
    this.k_sh_b1 = 2 * (this.K*this.K - this.Vh) / this.a0;
    this.k_sh_b2 = (this.Vh - this.Vb*this.K/this.Q + this.K*this.K) / this.a0;

    this.f0_hp = 38.13547087602444;
    this.Q_hp = 0.5003270373238773;
    this.K_hp = tan($pi * this.f0_hp / this.lufs_srate);
    
    this.hp_denom = 1 + this.K_hp/this.Q_hp + this.K_hp*this.K_hp;
    this.k_hp_a1 = 2 * (this.K_hp*this.K_hp - 1) / this.hp_denom;
    this.k_hp_a2 = (1 - this.K_hp/this.Q_hp + this.K_hp*this.K_hp) / this.hp_denom;
    this.k_hp_b0 = 1;
    this.k_hp_b1 = -2;
    this.k_hp_b2 = 1;
    
    this.lufs_st_block_len = max(1, floor(this.lufs_srate * 0.1));
    mod_meter_reset();
  );
);

function mod_meter_sample(l, r) local(tp_sum_l, tp_sum_r, tp_i, idx, tp_max_l, tp_max_r, tp_center_idx) (
  // TRUE PEAK (Circular Buffer)
  this.tp_hist_l[this.tp_idx] = l;
  this.tp_hist_r[this.tp_idx] = r;

  // Center sample (no interpolation, 16 samples ago)
  tp_center_idx = (this.tp_idx - 16) & 31;
  tp_max_l = abs(this.tp_hist_l[tp_center_idx]);
  tp_max_r = abs(this.tp_hist_r[tp_center_idx]);

  // Phase 1 (0.25 offset)
  tp_sum_l = 0; tp_sum_r = 0;
  tp_i = 0;
  idx = this.tp_idx;
  loop(this.sinc_sz,
      tp_sum_l += this.tp_hist_l[idx] * this.tp_s1[tp_i];
      tp_sum_r += this.tp_hist_r[idx] * this.tp_s1[tp_i];
      idx = (idx - 1) & 31;
      tp_i += 1;
  );
  tp_max_l = max(tp_max_l, abs(tp_sum_l));
  tp_max_r = max(tp_max_r, abs(tp_sum_r));

  // Phase 2 (0.50 offset)
  tp_sum_l = 0; tp_sum_r = 0;
  tp_i = 0;
  idx = this.tp_idx;
  loop(this.sinc_sz,
      tp_sum_l += this.tp_hist_l[idx] * this.tp_s2[tp_i];
      tp_sum_r += this.tp_hist_r[idx] * this.tp_s2[tp_i];
      idx = (idx - 1) & 31;
      tp_i += 1;
  );
  tp_max_l = max(tp_max_l, abs(tp_sum_l));
  tp_max_r = max(tp_max_r, abs(tp_sum_r));

  // Phase 3 (0.75 offset)
  tp_sum_l = 0; tp_sum_r = 0;
  tp_i = 0;
  idx = this.tp_idx;
  loop(this.sinc_sz,
      tp_sum_l += this.tp_hist_l[idx] * this.tp_s3[tp_i];
      tp_sum_r += this.tp_hist_r[idx] * this.tp_s3[tp_i];
      idx = (idx - 1) & 31;
      tp_i += 1;
  );
  tp_max_l = max(tp_max_l, abs(tp_sum_l));
  tp_max_r = max(tp_max_r, abs(tp_sum_r));

  this.tp_block_peak = max(this.tp_block_peak, max(tp_max_l, tp_max_r));
  this.tp_max_peak = max(this.tp_max_peak, this.tp_block_peak);
  
  this.tp_idx = (this.tp_idx + 1) & 31;
  
  // LUFS
  this.k_in = l;
  this.k_sh_w0 = this.k_in - this.k_sh_a1*this.k_sh_x1_l - this.k_sh_a2*this.k_sh_x2_l + this.denorm;
  this.k_y = this.k_sh_b0*this.k_sh_w0 + this.k_sh_b1*this.k_sh_x1_l + this.k_sh_b2*this.k_sh_x2_l;
  this.k_sh_x2_l = this.k_sh_x1_l; this.k_sh_x1_l = this.k_sh_w0;
  this.k_in = this.k_y;
  this.k_hp_w0 = this.k_in - this.k_hp_a1*this.k_hp_x1_l - this.k_hp_a2*this.k_hp_x2_l + this.denorm;
  this.k_y = this.k_hp_b0*this.k_hp_w0 + this.k_hp_b1*this.k_hp_x1_l + this.k_hp_b2*this.k_hp_x2_l;
  this.k_hp_x2_l = this.k_hp_x1_l; this.k_hp_x1_l = this.k_hp_w0;
  this.l_k = this.k_y;

  this.k_in = r;
  this.k_sh_w0 = this.k_in - this.k_sh_a1*this.k_sh_x1_r - this.k_sh_a2*this.k_sh_x2_r + this.denorm;
  this.k_y = this.k_sh_b0*this.k_sh_w0 + this.k_sh_b1*this.k_sh_x1_r + this.k_sh_b2*this.k_sh_x2_r;
  this.k_sh_x2_r = this.k_sh_x1_r; this.k_sh_x1_r = this.k_sh_w0;
  this.k_in = this.k_y;
  this.k_hp_w0 = this.k_in - this.k_hp_a1*this.k_hp_x1_r - this.k_hp_a2*this.k_hp_x2_r + this.denorm;
  this.k_y = this.k_hp_b0*this.k_hp_w0 + this.k_hp_b1*this.k_hp_x1_r + this.k_hp_b2*this.k_hp_x2_r;
  this.k_hp_x2_r = this.k_hp_x1_r; this.k_hp_x1_r = this.k_hp_w0;
  this.r_k = this.k_y;

  this.lufs_ms = (this.l_k*this.l_k + this.r_k*this.r_k);
  this.lufs_sum += this.lufs_ms;
  this.lufs_n += 1;

  this.lufs_st_acc += this.lufs_ms;
  this.lufs_st_n += 1;
  this.lufs_st_n >= this.lufs_st_block_len ? (
      this.lufs_st_block_ms = this.lufs_st_acc / max(1, this.lufs_st_n);
      this.lufs_st_prev = this.lufs_st_buf[this.lufs_st_idx];
      this.lufs_st_buf[this.lufs_st_idx] = this.lufs_st_block_ms;
      
      this.lufs_st_filled >= 30 ? (
        this.lufs_st_sum += this.lufs_st_block_ms - this.lufs_st_prev;
      ) : (
        this.lufs_st_sum += this.lufs_st_block_ms;
        this.lufs_st_filled += 1;
      );
      
      this.lufs_st_idx = (this.lufs_st_idx + 1) % 30;
      this.lufs_st_acc = 0;
      this.lufs_st_n = 0;
      
      this.lufs_st_e = this.lufs_st_filled > 0 ? (this.lufs_st_sum / this.lufs_st_filled) : 0;
      this.lufs_s_db = this.lufs_st_e > 0 ? (-0.691 + 10*log(this.lufs_st_e) * this.inv_log10) : -120;
      
      this.lufs_st_filled >= 4 ? (
        this.idx0 = (this.lufs_st_idx - 1 + 30) % 30;
        this.idx1 = (this.lufs_st_idx - 2 + 30) % 30;
        this.idx2 = (this.lufs_st_idx - 3 + 30) % 30;
        this.idx3 = (this.lufs_st_idx - 4 + 30) % 30;
        this.curr_400ms_p = (this.lufs_st_buf[this.idx0] + this.lufs_st_buf[this.idx1] + this.lufs_st_buf[this.idx2] + this.lufs_st_buf[this.idx3]) * 0.25;

        this.curr_400ms_p > this.gate_abs_p ? (
          this.lufs_abs_sum += this.curr_400ms_p;
          this.lufs_abs_count += 1;
          
          this.h_db = -0.691 + 10 * log(this.curr_400ms_p) * this.inv_log10;
          this.h_idx = floor((this.h_db + 70) * 10); 
          this.h_idx = max(0, min(999, this.h_idx));
          this.lufs_hist_cnt[this.h_idx] += 1;
          this.lufs_hist_p[this.h_idx] += this.curr_400ms_p;
        );

        this.lufs_abs_count > 0 ? (
          this.gate_rel_p = (this.lufs_abs_sum / this.lufs_abs_count) * 0.1;
          this.r_db = -0.691 + 10 * log(this.gate_rel_p) * this.inv_log10;
          this.r_idx = floor((this.r_db + 70) * 10);
          this.r_idx = max(0, min(999, this.r_idx));
          
          this.lufs_rel_sum = 0;
          this.lufs_rel_count = 0;
          
          this.hi = this.r_idx;
          loop(1000 - this.r_idx,
            this.lufs_rel_sum += this.lufs_hist_p[this.hi];
            this.lufs_rel_count += this.lufs_hist_cnt[this.hi];
            this.hi += 1;
          );
          this.lufs_i_db = this.lufs_rel_count > 0 ? (-0.691 + 10*log(this.lufs_rel_sum / this.lufs_rel_count) * this.inv_log10) : -120;
        ) : (
          this.lufs_i_db = -120;
        );
      );
  );
);

function mod_meter_gfx(x, y, w, h, scale) local(peak_min_db, peak_max_db, tp_db, tp_limit, tp_overs, lufs_min_db, lufs_max_db, lufs_valid, lufs_read_db, lufs_val_db, lufs_limit, lufs_overs, meter_bar_h, title_h, meter_w, bar_y, tx, tp_norm, tp_fill, tp_lim_norm, tp_lim_x, tp_warn_norm, tp_warn_w, tp_crit_w, w_g, w_y, w_r, lufs_norm, lufs_fill, lufs_lim_norm, lufs_lim_x, lufs_warn_norm, lufs_warn_w, lufs_crit_w, f_sz_title, f_sz_val, inner_y, inner_h, tp_bar_y, lufs_bar_y, pad_x, min_gap, f_sz_val_base, f_sz_lim, f_sz_lim_base, gap_y, th_val, lim_w0, lim_h0, bottom_pad, top_pad, content_top, content_bottom, content_h, min_gap_base, f_ratio, bar_h_cap, bar_h_max, fit_iter, fit_ok, min_font, lufs_text_y) (
  // Background
  gfx_r=c_panel_r; gfx_g=c_panel_g; gfx_b=c_panel_b; gfx_a=1;
  gfx_rect(x, y, w, h);
  gfx_r=c_panel_edge_r; gfx_g=c_panel_edge_g; gfx_b=c_panel_edge_b; gfx_a=1;
  gfx_line(x, y, x+w, y);
  gfx_line(x, y+h, x+w, y+h);
  gfx_line(x, y, x, y+h);
  gfx_line(x+w, y, x+w, y+h);
  
  title_h = 0;
  top_pad = max(4, floor(6 * scale));
  bottom_pad = max(2, floor(4 * scale));
  inner_y = y + top_pad;
  inner_h = h - top_pad - bottom_pad;
  inner_h < 1 ? inner_h = 1;
  pad_x = floor(10 * scale);
  meter_w = w - pad_x * 2;
  bar_h_max = floor(18 * scale) + 2;
  meter_bar_h = max(10, min(floor(inner_h * 0.10), bar_h_max));
  f_sz_title = f_sz_norm;
  f_sz_val_base = max(f_sz_norm, f_sz_meter);
  f_sz_lim_base = max(f_sz_norm, floor(12 * scale));
  f_sz_val = f_sz_val_base;
  f_sz_lim = f_sz_lim_base;
  
  gap_y = max(2, floor(2 * scale));
  min_gap_base = max(10, floor(14 * scale));
  min_gap = min_gap_base;
  
  // Title removed to save space
  
  is_playing = (play_state&1);
  
  peak_min_db = -60; peak_max_db = 6;
  tp_db = is_playing ? (20*log(this.tp_meter + 0.0000000001) * this.inv_log10) : -144.0;
  is_playing ? tp_db = max(peak_min_db, min(peak_max_db, tp_db));
  tp_limit = max(peak_min_db, min(peak_max_db, this.tp_limit_db));
  
  min_font = 8;
  fit_ok = 0;
  fit_iter = 0;
  while (fit_iter < 5 && !fit_ok) (
    gfx_setfont(1, #font_ui, f_sz_val);
    gfx_measurestr("TP:", tx, th_val);
    gfx_setfont(1, #font_ui, f_sz_lim);
    sprintf(#limstr, "LIM %+.1f LUFS", this.lufs_s_limit_db);
    gfx_measurestr(#limstr, lim_w0, lim_h0);
    
    content_top = y + top_pad;
    content_bottom = y + h - bottom_pad - lim_h0 - gap_y;
    content_h = content_bottom - content_top;
    
    f_ratio = f_sz_val / max(1, f_sz_val_base);
    min_gap = floor(min_gap_base * f_ratio);
    min_gap < 4 ? min_gap = 4;
    
    bar_h_cap = floor((content_h - (2*th_val + 2*gap_y + min_gap)) * 0.5);
    bar_h_cap > bar_h_max ? bar_h_cap = bar_h_max;
    meter_bar_h = bar_h_cap;
    meter_bar_h < 6 ? meter_bar_h = 6;
    
    content_h >= (2*th_val + 2*gap_y + min_gap + 2*6) ? (
      fit_ok = 1;
    ) : (
      f_sz_val = floor(f_sz_val * 0.88);
      f_sz_lim = floor(f_sz_lim * 0.88);
      f_sz_val < min_font ? f_sz_val = min_font;
      f_sz_lim < min_font ? f_sz_lim = min_font;
      fit_iter += 1;
      (f_sz_val == min_font && f_sz_lim == min_font) ? fit_ok = 1;
    );
  );
  
  tp_bar_y = y + top_pad + th_val + gap_y;
  lufs_text_y = tp_bar_y + meter_bar_h + min_gap;
  lufs_bar_y = lufs_text_y + th_val + gap_y;
  
  bar_y = tp_bar_y;
  gfx_r=0.1; gfx_g=0.1; gfx_b=0.1; gfx_a=1;
  gfx_rect(x + pad_x, bar_y, meter_w, meter_bar_h);
  
  tp_norm = is_playing ? max(0, min(1, (tp_db - peak_min_db) / (peak_max_db - peak_min_db))) : 0;
  tp_fill = tp_norm * meter_w;
  tp_lim_norm = max(0, min(1, (tp_limit - peak_min_db) / (peak_max_db - peak_min_db)));
  tp_warn_norm = max(0, min(1, (tp_limit - 1.0 - peak_min_db) / (peak_max_db - peak_min_db)));
  
  tp_warn_w = tp_warn_norm * meter_w;
  tp_crit_w = tp_lim_norm * meter_w;
  
  w_g = min(tp_fill, tp_warn_w);
  w_g > 0 ? ( gfx_r=0.15; gfx_g=0.65; gfx_b=0.35; gfx_a=1; gfx_rect(x + pad_x, bar_y, w_g, meter_bar_h); );
  
  w_y = min(tp_fill, tp_crit_w) - tp_warn_w;
  w_y > 0 ? ( gfx_r=0.75; gfx_g=0.65; gfx_b=0.10; gfx_a=1; gfx_rect(x + pad_x + tp_warn_w, bar_y, w_y, meter_bar_h); );
  
  w_r = tp_fill - tp_crit_w;
  w_r > 0 ? ( gfx_r=0.75; gfx_g=0.10; gfx_b=0.10; gfx_a=1; gfx_rect(x + pad_x + tp_crit_w, bar_y, w_r, meter_bar_h); );

  // TP Values
  gfx_setfont(1, #font_ui, f_sz_val);
  gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=0.8;
  gfx_measurestr("TP:", tp_pref_w, th);
  gfx_measurestr(" ", tp_sp_w, th);
  gfx_measurestr(" dB", tp_suf_w, th);
  gfx_measurestr("-60.0", tp_num_max_w1, th);
  gfx_measurestr(" -inf", tp_num_max_w2, th);
  tp_num_box_w = max(tp_num_max_w1, tp_num_max_w2);
  
  is_playing ? sprintf(#tpnum, "%+.1f", tp_db) : strcpy(#tpnum, "-inf");
  gfx_measurestr(#tpnum, tp_num_w, th);
  
  tp_x0 = x + w - pad_x - (tp_pref_w + tp_sp_w + tp_num_box_w + tp_suf_w);
  gfx_y = bar_y - th - gap_y;
  
  gfx_x = tp_x0;
  gfx_drawstr("TP:");
  
  gfx_x = tp_x0 + tp_pref_w;
  gfx_drawstr(" ");
  
  gfx_x = tp_x0 + tp_pref_w + tp_sp_w + (tp_num_box_w - tp_num_w);
  gfx_drawstr(#tpnum);
  
  gfx_x = tp_x0 + tp_pref_w + tp_sp_w + tp_num_box_w;
  gfx_drawstr(" dB");
  
  tp_max_db_val = 20*log(this.tp_max_peak + 0.0000000001) * this.inv_log10;
  this.tp_max_peak == 0 ? tp_max_db_val = -144.0;
  tp_max_db_val <= -100 ? sprintf(#max_val_str, "MAX: -inf dB") : sprintf(#max_val_str, "MAX: %+.1f dB", tp_max_db_val);
  gfx_measurestr(#max_val_str, max_val_w, max_val_h);
  max_x = x + pad_x; max_y = gfx_y;
  
  hover_max = mouse_x >= max_x && mouse_x <= max_x + max_val_w && mouse_y >= max_y && mouse_y <= max_y + max_val_h;
  hover_max && ui_click_l ? (
    this.tp_max_peak = 0;
    tp_max_db_val = -144.0;
  );
  tp_max_db_val > tp_limit ? (
    gfx_r=1; gfx_g=0.25; gfx_b=0.25; gfx_a=1;
  ) : (
    gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=hover_max ? 1.0 : 0.8;
  );
  gfx_x = max_x; gfx_drawstr(#max_val_str);
  
  // LUFS Bar
  lufs_min_db = -36; lufs_max_db = 6;
  lufs_valid = (this.lufs_st_filled > 0) && is_playing;
  lufs_read_db = lufs_valid ? this.lufs_s_db : lufs_min_db;
  lufs_val_db = max(lufs_min_db, min(lufs_max_db, lufs_read_db));
  
  bar_y = lufs_bar_y;
  gfx_r=0.1; gfx_g=0.1; gfx_b=0.1; gfx_a=1;
  gfx_rect(x + pad_x, bar_y, meter_w, meter_bar_h);
  
  lufs_norm = max(0, min(1, (lufs_val_db - lufs_min_db) / (lufs_max_db - lufs_min_db)));
  lufs_fill = lufs_valid ? (lufs_norm * meter_w) : 0;
  lufs_lim_norm = max(0, min(1, (this.lufs_s_limit_db - lufs_min_db) / (lufs_max_db - lufs_min_db)));
  lufs_warn_norm = max(0, min(1, (this.lufs_s_limit_db - 1.0 - lufs_min_db) / (lufs_max_db - lufs_min_db)));
  
  lufs_warn_w = lufs_warn_norm * meter_w;
  lufs_crit_w = lufs_lim_norm * meter_w;
  
  lufs_valid ? (
    w_g = min(lufs_fill, lufs_warn_w);
    w_g > 0 ? ( gfx_r=0.15; gfx_g=0.65; gfx_b=0.35; gfx_a=1; gfx_rect(x + pad_x, bar_y, w_g, meter_bar_h); );
    
    w_y = min(lufs_fill, lufs_crit_w) - lufs_warn_w;
    w_y > 0 ? ( gfx_r=0.75; gfx_g=0.65; gfx_b=0.10; gfx_a=1; gfx_rect(x + pad_x + lufs_warn_w, bar_y, w_y, meter_bar_h); );
    
    w_r = lufs_fill - lufs_crit_w;
    w_r > 0 ? ( gfx_r=0.75; gfx_g=0.10; gfx_b=0.10; gfx_a=1; gfx_rect(x + pad_x + lufs_crit_w, bar_y, w_r, meter_bar_h); );
  );

  // LUFS Values
  gfx_setfont(1, #font_ui, f_sz_val);
  gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=0.8;
  gfx_measurestr("LUFS-S:", lufs_pref_w, th);
  gfx_measurestr(" ", lufs_sp_w, th);
  gfx_measurestr("-36.0", lufs_num_max_w1, th);
  gfx_measurestr("+6.0", lufs_num_max_w2, th);
  gfx_measurestr("--.-", lufs_num_max_w3, th);
  lufs_num_box_w = max(lufs_num_max_w1, max(lufs_num_max_w2, lufs_num_max_w3));
  
  lufs_valid ? sprintf(#lufs_num, "%+.1f", this.lufs_s_db) : strcpy(#lufs_num, "--.-");
  gfx_measurestr(#lufs_num, lufs_num_w, th);
  
  lufs_w = lufs_pref_w + lufs_sp_w + lufs_num_box_w;
  lufs_x = x + w - pad_x - lufs_w;
  lufs_y = bar_y - th - gap_y;
  
  this.lufs_abs_count > 0 ? sprintf(#lufsi, "INT: %+.1f", this.lufs_i_db) : sprintf(#lufsi, "INT: --.-");
  gfx_measurestr(#lufsi, int_w, int_h);
  int_x = x + pad_x; int_y = lufs_y;
  
  hover_lufs = (mouse_x >= lufs_x && mouse_x <= lufs_x + lufs_w && mouse_y >= lufs_y && mouse_y <= lufs_y + th) ||
               (mouse_x >= int_x && mouse_x <= int_x + int_w && mouse_y >= int_y && mouse_y <= int_y + int_h);
               
  hover_lufs && ui_click_l ? (
    this.mod_meter_clear_history();
  );
  
  gfx_a = hover_lufs ? 1.0 : 0.8;
  gfx_x = lufs_x; gfx_y = lufs_y; gfx_drawstr("LUFS-S:");
  gfx_x = lufs_x + lufs_pref_w; gfx_y = lufs_y; gfx_drawstr(" ");
  gfx_x = lufs_x + lufs_pref_w + lufs_sp_w + (lufs_num_box_w - lufs_num_w); gfx_y = lufs_y; gfx_drawstr(#lufs_num);
  gfx_x = int_x; gfx_y = int_y; gfx_drawstr(#lufsi);

  // LUFS target (bottom-right)
  gfx_setfont(1, #font_ui, f_sz_lim);
  gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=0.55;
  sprintf(#limstr, "LIM %+.1f LUFS", this.lufs_s_limit_db);
  gfx_measurestr(#limstr, lim_w, lim_h);
  lim_w > (w - floor(20*scale)) ? (
    sprintf(#limstr, "LIM %+.1f", this.lufs_s_limit_db);
    gfx_measurestr(#limstr, lim_w, lim_h);
  );
  gfx_x = x + w - floor(10*scale) - lim_w;
  gfx_y = y + h - lim_h - floor(4*scale);
  gfx_drawstr(#limstr);

);
