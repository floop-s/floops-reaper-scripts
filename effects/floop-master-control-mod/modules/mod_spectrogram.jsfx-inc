@init

// Floop Master Control - Spectrogram Module
// @author Floop-s

function mod_spectrogram_init(slot_id, mem_start, mem_size) local(ptr, i) (
  ptr = mem_start;
  this.slot_id = slot_id;
  this.mem = mem_start;
  
  this.fft_size = 4096;
  this.fft_overlap_factor = 8; // Increased from 4 to 8 for 2x faster visual update rate
  this.fft_step_size = this.fft_size / this.fft_overlap_factor;
  this.fft_bins = this.fft_size / 2;
  
  // Align pointer to prevent FFT buffers from crossing 65536 element boundaries
  this.ptr_rem = ptr % (this.fft_size * 2);
  this.ptr_rem > 0 ? ptr += (this.fft_size * 2) - this.ptr_rem;
  
  this.fft_buf = ptr; ptr += this.fft_size * 2;
  this.spec_buf = ptr; ptr += this.fft_bins;
  this.win_buf = ptr; ptr += this.fft_size;
  
  this.fft_ring_size = 8192; // Power of 2 for bitwise masking
  this.fft_ring_mask = this.fft_ring_size - 1;
  this.fft_ring_buf_m = ptr; ptr += this.fft_ring_size;
  
  this.fft_ring_wr = 0;
  this.fft_ring_rd = 0;
  
  this.inv_log10 = 1/log(10);
  this.inv_log2 = 1/log(2);
  this.log_1000 = log(1000);
  
  this.win_sum = 0;
  i = 0;
  loop(this.fft_size,
    this.win_buf[i] = 0.5 * (1 - cos(2*$pi*i/(this.fft_size-1)));
    this.win_sum += this.win_buf[i];
    i += 1;
  );
  
  memset(this.spec_buf, 0, this.fft_bins);
  memset(this.fft_ring_buf_m, 0, this.fft_ring_size);
  memset(this.fft_buf, 0, this.fft_size * 2);
  
  this.spec_img = 20 + slot_id; // Unique image buffer ID
  this.spec_img_tmp = 40 + slot_id;
  this.img_w = 0;
  this.img_h = 0;
  this.col_x = 0;
  this.speed = 1;
  
  this.spec_disp_min_db = -90;
  this.spec_disp_max_db = 0;
);

function mod_spectrogram_reset() (
  // Intentionally empty to preserve spectrogram history across loop boundaries.
  0;
);

function mod_spectrogram_block(speed) (
  this.speed = max(1, floor(speed));
);

function mod_spectrogram_sample(l, r) (
  // Store mono sum for spectrogram
  this.fft_ring_buf_m[this.fft_ring_wr] = (l + r) * 0.5;
  this.fft_ring_wr = (this.fft_ring_wr + 1) & this.fft_ring_mask;
);

function mod_spectrogram_color_map(val) (
  val < 0 ? val = 0;
  val > 1 ? val = 1;
  
  // Inferno-style gradient, starting from c_panel background
  val < 0.25 ? (
    this.cr = c_panel_r + (val * 4) * (0.3 - c_panel_r); // c_panel_r to 0.3
    this.cg = c_panel_g + (val * 4) * (0.0 - c_panel_g); // c_panel_g to 0
    this.cb = c_panel_b + (val * 4) * (0.5 - c_panel_b); // c_panel_b to 0.5
  ) : val < 0.5 ? (
    this.cr = 0.3 + (val - 0.25) * 4 * 0.5; // 0.3 to 0.8 (red/magenta)
    this.cg = 0;
    this.cb = 0.5 - (val - 0.25) * 4 * 0.3; // 0.5 to 0.2
  ) : val < 0.75 ? (
    this.cr = 0.8 + (val - 0.5) * 4 * 0.2; // 0.8 to 1.0 (orange/yellow)
    this.cg = (val - 0.5) * 4 * 0.8; // 0 to 0.8
    this.cb = 0.2 - (val - 0.5) * 4 * 0.2; // 0.2 to 0
  ) : (
    this.cr = 1.0;
    this.cg = 0.8 + (val - 0.75) * 4 * 0.2; // 0.8 to 1.0 (white/yellow)
    this.cb = (val - 0.75) * 4 * 1.0; // 0 to 1.0
  );
);

function mod_spectrogram_gfx(x, y, w, h, scale) local(avail, r_ptr, si, sw, m_samp, s_re, s_im, s_mag, title_h, top_pad, bottom_pad, spec_x, spec_y, spec_w, spec_h, f_min, f_max, lf_min, lf_max, lf_den, f, y_coord, db, norm_val, f_lo, f_hi, k0, k1, mag_sum, mag_n, k, mag_val, i, t, lf, new_frames, draw_w, w1, w2, frame_budget, pos, frac, mag0, mag1) (
  // Background
  gfx_r=c_panel_r; gfx_g=c_panel_g; gfx_b=c_panel_b; gfx_a=1;
  gfx_rect(x, y, w, h);
  gfx_r=c_panel_edge_r; gfx_g=c_panel_edge_g; gfx_b=c_panel_edge_b; gfx_a=1;
  gfx_line(x, y, x+w, y);
  gfx_line(x, y+h, x+w, y+h);
  gfx_line(x, y, x, y+h);
  gfx_line(x+w, y, x+w, y+h);
  
  title_h = 0;
  top_pad = max(4, floor(6 * scale));
  bottom_pad = max(4, floor(6 * scale));
  spec_x = x + floor(10*scale);
  spec_y = y + top_pad;
  spec_w = w - floor(20*scale);
  spec_h = h - top_pad - bottom_pad;
  spec_w < 1 ? spec_w = 1;
  spec_h < 1 ? spec_h = 1;
  
  hover = mouse_x >= spec_x && mouse_x < spec_x + spec_w && mouse_y >= spec_y && mouse_y < spec_y + spec_h;
  hover && mouse_wheel != 0 ? (
    this.speed += (mouse_wheel > 0 ? 1 : -1);
    this.speed = max(1, min(10, this.speed));
    spectrogram_speed = this.speed;
    slider21 = this.speed;
    sliderchange(slider21); slider_automate(1<<20);
    mouse_wheel = 0;
  );

  // Init/Resize Offscreen Buffer
  (this.img_w != floor(spec_w) || this.img_h != floor(spec_h)) ? (
    old_w = this.img_w;
    old_h = this.img_h;
    old_col = this.col_x;
    
    (old_w > 0 && old_h > 0) ? (
      gfx_setimgdim(this.spec_img_tmp, old_w, old_h);
      gfx_dest = this.spec_img_tmp;
      gfx_a = 1;
      gfx_r=c_panel_r; gfx_g=c_panel_g; gfx_b=c_panel_b; gfx_a=1;
      gfx_rect(0, 0, old_w, old_h, 1);
      
      gfx_x = 0; gfx_y = 0;
      gfx_blit(this.spec_img, 1, 0, old_col, 0, old_w - old_col, old_h);
      gfx_x = old_w - old_col; gfx_y = 0;
      gfx_blit(this.spec_img, 1, 0, 0, 0, old_col, old_h);
    );
    
    this.img_w = max(1, floor(spec_w));
    this.img_h = max(1, floor(spec_h));
    gfx_setimgdim(this.spec_img, this.img_w, this.img_h);
    gfx_dest = this.spec_img;
    gfx_r=c_panel_r; gfx_g=c_panel_g; gfx_b=c_panel_b; gfx_a=1;
    gfx_rect(0, 0, this.img_w, this.img_h, 1);
    (old_w > 0 && old_h > 0) ? (
      gfx_x = 0; gfx_y = 0;
      gfx_blit(this.spec_img_tmp, 1, 0, 0, 0, old_w, old_h, 0, 0, this.img_w, this.img_h);
    );
    this.col_x = 0;
  );

  // Process FFT Queue
  avail = (this.fft_ring_wr - this.fft_ring_rd + this.fft_ring_size) & this.fft_ring_mask;
  avail > this.fft_size ? (
     this.fft_ring_rd = (this.fft_ring_wr - this.fft_size) & this.fft_ring_mask;
     avail = this.fft_size;
  );
  
  new_frames = 0;
  
  frame_budget = max(1, min(4, this.speed));
  while (avail >= this.fft_step_size && new_frames < frame_budget) (
     this.fft_ring_rd = (this.fft_ring_rd + this.fft_step_size) & this.fft_ring_mask;
     avail -= this.fft_step_size;
     
     r_ptr = (this.fft_ring_rd - this.fft_size + this.fft_ring_size) & this.fft_ring_mask;
     
     si = 0;
     loop(this.fft_size,
        sw = this.win_buf[si];
        m_samp = this.fft_ring_buf_m[r_ptr];
        
        this.fft_buf[si*2] = m_samp * sw;
        this.fft_buf[si*2+1] = 0;
        
        r_ptr = (r_ptr + 1) & this.fft_ring_mask;
        si += 1;
     );
     
     fft(this.fft_buf, this.fft_size);
     fft_permute(this.fft_buf, this.fft_size);
     this.fft_buf[1] = 0;
     
     si = 0;
     loop(this.fft_bins,
        s_re = this.fft_buf[si * 2];
        s_im = this.fft_buf[si * 2 + 1];
        s_mag = sqrt(s_re * s_re + s_im * s_im) * (2 / max(0.000000000001, this.win_sum));
        
        this.spec_buf[si] = s_mag;
        si += 1;
     );
     
     // IMMEDIATELY DRAW THIS FRAME TO OFFSCREEN BUFFER TO PREVENT FRAME DROPS
     gfx_dest = this.spec_img;
     
     f_min = 20; f_max = srate * 0.5;
     lf_min = log(f_min); lf_max = log(f_max); lf_den = lf_max - lf_min;

     draw_w = min(this.speed, this.img_w);
     w1 = min(draw_w, this.img_w - this.col_x);
     w2 = draw_w - w1;

     i = 0;
     loop(this.img_h,
       t = 1.0 - (i / max(1, (this.img_h - 1)));
       lf = lf_min + t * lf_den;
       f = exp(lf);
       
       pos = f * this.fft_size / srate;
       k0 = floor(pos);
       frac = pos - k0;
       k0 = max(0, min(this.fft_bins - 1, k0));
       k1 = min(this.fft_bins - 1, k0 + 1);
       mag0 = this.spec_buf[k0];
       mag1 = this.spec_buf[k1];
       mag_val = mag0 + (mag1 - mag0) * frac;
       
       db = 20 * log(mag_val + 0.000000000001) * this.inv_log10;
       db += 3.0 * ((lf - this.log_1000) * this.inv_log2);
       
       norm_val = (db - this.spec_disp_min_db) / (this.spec_disp_max_db - this.spec_disp_min_db);
       
       this.mod_spectrogram_color_map(norm_val);
       gfx_r = this.cr; gfx_g = this.cg; gfx_b = this.cb; gfx_a = 1.0;
       
       gfx_rect(this.col_x, i, w1, 1);
       w2 > 0 ? gfx_rect(0, i, w2, 1);
       
       i += 1;
     );
     
     this.col_x = (this.col_x + draw_w) % this.img_w;
     
     new_frames += 1;
  );

  // Render Offscreen Buffer to Screen
  gfx_dest = -1; // Back to main screen
  gfx_a = 1;
  
  // We draw the image in two halves to create the scrolling effect
  // Right half of buffer goes to left side of screen
  gfx_x = spec_x; gfx_y = spec_y;
  gfx_blit(this.spec_img, 1, 0, this.col_x, 0, this.img_w - this.col_x, this.img_h);
  
  // Left half of buffer goes to right side of screen
  gfx_x = spec_x + (this.img_w - this.col_x); gfx_y = spec_y;
  gfx_blit(this.spec_img, 1, 0, 0, 0, this.col_x, this.img_h);

  // Draw Frequency Grid overlay
  gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=0.1;
  f_min = 20; f_max = srate * 0.5;
  lf_min = log(f_min); lf_max = log(f_max); lf_den = lf_max - lf_min;
  
  f = 100;
  while(f < f_max) (
    y_coord = spec_y + spec_h - ((log(f) - lf_min) / lf_den) * spec_h;
    y_coord >= spec_y && y_coord <= spec_y + spec_h ? (
      gfx_line(spec_x, y_coord, spec_x + spec_w, y_coord);
    );
    f *= 10;
  );

  fs_lbl = min(f_sz_small, max(9, floor(10 * scale)));
  compact_mode ? fs_lbl = max(f_sz_small, fs_lbl + 2);
  gfx_setfont(1, #font_ui, fs_lbl);
  gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=0.55;
  gfx_measurestr("10k", tw, th);

  label_pad = max(2, floor(2 * scale));
  label_h = max(1, th);
  max_by_h = floor(spec_h / max(1, (label_h + label_pad * 2)));
  desired = min(8, max_by_h);
  compact_mode ? desired = min(desired, 4);
  desired < 1 ? desired = 1;
  min_gap = max(label_h + label_pad * 2, floor(spec_h / desired));

  last_y = spec_y - 999999;
  kept = 0;

  f_tick = 10000;
  loop(8,
    (f_tick >= f_min && f_tick <= f_max) ? (
      y_tick = spec_y + spec_h - ((log(f_tick) - lf_min) / lf_den) * spec_h;
      (y_tick >= spec_y && y_tick <= spec_y + spec_h && y_tick - last_y >= min_gap && kept < desired) ? (
        f_tick >= 1000 ? sprintf(#fs, "%dk", floor(f_tick/1000)) : sprintf(#fs, "%d", floor(f_tick));
        gfx_measurestr(#fs, tw, th);
        tx = spec_x + floor(2*scale);
        ty = y_tick - th * 0.5;
        ty < spec_y ? ty = spec_y;
        ty + th > spec_y + spec_h ? ty = spec_y + spec_h - th;
        gfx_r=0.08; gfx_g=0.08; gfx_b=0.08; gfx_a=0.55;
        gfx_rect(tx - label_pad, ty - label_pad, tw + label_pad*2, th + label_pad*2);
        gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=0.65;
        gfx_line(spec_x, y_tick, spec_x + floor(4*scale), y_tick);
        gfx_x = tx; gfx_y = ty;
        gfx_drawstr(#fs);
        last_y = y_tick;
        kept += 1;
      );
    );
    f_tick == 10000 ? f_tick = 5000 :
    f_tick == 5000 ? f_tick = 2000 :
    f_tick == 2000 ? f_tick = 1000 :
    f_tick == 1000 ? f_tick = 500 :
    f_tick == 500 ? f_tick = 200 :
    f_tick == 200 ? f_tick = 100 :
    f_tick == 100 ? f_tick = 50 :
                    f_tick = 0;
  );

);
