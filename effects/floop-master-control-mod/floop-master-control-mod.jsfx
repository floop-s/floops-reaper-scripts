  xover2_coeff_fc = -1;

  lp1_1_x1_l = lp1_1_x2_l = lp1_1_y1_l = lp1_1_y2_l = 0;
  lp1_2_x1_l = lp1_2_x2_l = lp1_2_y1_l = lp1_2_y2_l = 0;
  hp1_1_x1_l = hp1_1_x2_l = hp1_1_y1_l = hp1_1_y2_l = 0;
  hp1_2_x1_l = hp1_2_x2_l = hp1_2_y1_l = hp1_2_y2_l = 0;
  lp2_1_x1_l = lp2_1_x2_l = lp2_1_y1_l = lp2_1_y2_l = 0;
  lp2_2_x1_l = lp2_2_x2_l = lp2_2_y1_l = lp2_2_y2_l = 0;
  hp2_1_x1_l = hp2_1_x2_l = hp2_1_y1_l = hp2_1_y2_l = 0;
  hp2_2_x1_l = hp2_2_x2_l = hp2_2_y1_l = hp2_2_y2_l = 0;

