@sample
l = spl0;
r = spl1;

// 1. PRE-MONITOR ANALYSIS
active_slot1_type > 0 ? ( active_slot1_type == 1 ? slot1_m1.mod_meter_sample(l, r) : active_slot1_type == 3 ? slot1_m3.mod_phase_sample(l, r) : active_slot1_type == 8 ? slot1_m8.mod_vumeter_sample(l, r); );
active_slot2_type > 0 ? ( active_slot2_type == 1 ? slot2_m1.mod_meter_sample(l, r) : active_slot2_type == 3 ? slot2_m3.mod_phase_sample(l, r) : active_slot2_type == 8 ? slot2_m8.mod_vumeter_sample(l, r); );
active_slot3_type > 0 ? ( active_slot3_type == 1 ? slot3_m1.mod_meter_sample(l, r) : active_slot3_type == 3 ? slot3_m3.mod_phase_sample(l, r) : active_slot3_type == 8 ? slot3_m8.mod_vumeter_sample(l, r); );
active_slot4_type > 0 ? ( active_slot4_type == 1 ? slot4_m1.mod_meter_sample(l, r) : active_slot4_type == 3 ? slot4_m3.mod_phase_sample(l, r) : active_slot4_type == 8 ? slot4_m8.mod_vumeter_sample(l, r); );
active_slot5_type > 0 ? ( active_slot5_type == 1 ? slot5_m1.mod_meter_sample(l, r) : active_slot5_type == 3 ? slot5_m3.mod_phase_sample(l, r) : active_slot5_type == 8 ? slot5_m8.mod_vumeter_sample(l, r); );
active_slot6_type > 0 ? ( active_slot6_type == 1 ? slot6_m1.mod_meter_sample(l, r) : active_slot6_type == 3 ? slot6_m3.mod_phase_sample(l, r) : active_slot6_type == 8 ? slot6_m8.mod_vumeter_sample(l, r); );
active_slot7_type > 0 ? ( active_slot7_type == 1 ? slot7_m1.mod_meter_sample(l, r) : active_slot7_type == 3 ? slot7_m3.mod_phase_sample(l, r) : active_slot7_type == 8 ? slot7_m8.mod_vumeter_sample(l, r); );
active_slot8_type > 0 ? ( active_slot8_type == 1 ? slot8_m1.mod_meter_sample(l, r) : active_slot8_type == 3 ? slot8_m3.mod_phase_sample(l, r) : active_slot8_type == 8 ? slot8_m8.mod_vumeter_sample(l, r); );
active_slot9_type > 0 ? ( active_slot9_type == 1 ? slot9_m1.mod_meter_sample(l, r) : active_slot9_type == 3 ? slot9_m3.mod_phase_sample(l, r) : active_slot9_type == 8 ? slot9_m8.mod_vumeter_sample(l, r); );

// 2. MONITOR ROUTING
out_l = l; out_r = r;
monitor_mode == 1 ? ( m = (out_l + out_r) * 0.5; out_l = m; out_r = m; );
monitor_mode == 2 ? ( side = (l - r) * 0.5; out_l = side; out_r = -side; );

band_xfade = band_xfade * band_xfade_a + band_target * band_xfade_b;

(band_xfade > 0.00001) ? (
  x = out_l;
  y = lp1_b0*x + lp1_b1*lp1_1_x1_l + lp1_b2*lp1_1_x2_l - lp1_a1*lp1_1_y1_l - lp1_a2*lp1_1_y2_l + 10^-24;
  lp1_1_x2_l = lp1_1_x1_l; lp1_1_x1_l = x; lp1_1_y2_l = lp1_1_y1_l; lp1_1_y1_l = y;
  x = y;
  y = lp1_b0*x + lp1_b1*lp1_2_x1_l + lp1_b2*lp1_2_x2_l - lp1_a1*lp1_2_y1_l - lp1_a2*lp1_2_y2_l + 10^-24;
  lp1_2_x2_l = lp1_2_x1_l; lp1_2_x1_l = x; lp1_2_y2_l = lp1_2_y1_l; lp1_2_y1_l = y;
  low_l = y;

  x = out_l;
  y = hp1_b0*x + hp1_b1*hp1_1_x1_l + hp1_b2*hp1_1_x2_l - hp1_a1*hp1_1_y1_l - hp1_a2*hp1_1_y2_l + 10^-24;
  hp1_1_x2_l = hp1_1_x1_l; hp1_1_x1_l = x; hp1_1_y2_l = hp1_1_y1_l; hp1_1_y1_l = y;
  x = y;
  y = hp1_b0*x + hp1_b1*hp1_2_x1_l + hp1_b2*hp1_2_x2_l - hp1_a1*hp1_2_y1_l - hp1_a2*hp1_2_y2_l + 10^-24;
  hp1_2_x2_l = hp1_2_x1_l; hp1_2_x1_l = x; hp1_2_y2_l = hp1_2_y1_l; hp1_2_y1_l = y;
  hi1_l = y;

  x = hi1_l;
  y = lp2_b0*x + lp2_b1*lp2_1_x1_l + lp2_b2*lp2_1_x2_l - lp2_a1*lp2_1_y1_l - lp2_a2*lp2_1_y2_l + 10^-24;
  lp2_1_x2_l = lp2_1_x1_l; lp2_1_x1_l = x; lp2_1_y2_l = lp2_1_y1_l; lp2_1_y1_l = y;
  x = y;
  y = lp2_b0*x + lp2_b1*lp2_2_x1_l + lp2_b2*lp2_2_x2_l - lp2_a1*lp2_2_y1_l - lp2_a2*lp2_2_y2_l + 10^-24;
  lp2_2_x2_l = lp2_2_x1_l; lp2_2_x1_l = x; lp2_2_y2_l = lp2_2_y1_l; lp2_2_y1_l = y;
  mid_l = y;

  x = hi1_l;
  y = hp2_b0*x + hp2_b1*hp2_1_x1_l + hp2_b2*hp2_1_x2_l - hp2_a1*hp2_1_y1_l - hp2_a2*hp2_1_y2_l + 10^-24;
  hp2_1_x2_l = hp2_1_x1_l; hp2_1_x1_l = x; hp2_1_y2_l = hp2_1_y1_l; hp2_1_y1_l = y;
  x = y;
  y = hp2_b0*x + hp2_b1*hp2_2_x1_l + hp2_b2*hp2_2_x2_l - hp2_a1*hp2_2_y1_l - hp2_a2*hp2_2_y2_l + 10^-24;
  hp2_2_x2_l = hp2_2_x1_l; hp2_2_x1_l = x; hp2_2_y2_l = hp2_2_y1_l; hp2_2_y1_l = y;
  high_l = y;

  x = out_r;
  y = lp1_b0*x + lp1_b1*lp1_1_x1_r + lp1_b2*lp1_1_x2_r - lp1_a1*lp1_1_y1_r - lp1_a2*lp1_1_y2_r + 10^-24;
  lp1_1_x2_r = lp1_1_x1_r; lp1_1_x1_r = x; lp1_1_y2_r = lp1_1_y1_r; lp1_1_y1_r = y;
  x = y;
  y = lp1_b0*x + lp1_b1*lp1_2_x1_r + lp1_b2*lp1_2_x2_r - lp1_a1*lp1_2_y1_r - lp1_a2*lp1_2_y2_r + 10^-24;
  lp1_2_x2_r = lp1_2_x1_r; lp1_2_x1_r = x; lp1_2_y2_r = lp1_2_y1_r; lp1_2_y1_r = y;
  low_r = y;

  x = out_r;
  y = hp1_b0*x + hp1_b1*hp1_1_x1_r + hp1_b2*hp1_1_x2_r - hp1_a1*hp1_1_y1_r - hp1_a2*hp1_1_y2_r + 10^-24;
  hp1_1_x2_r = hp1_1_x1_r; hp1_1_x1_r = x; hp1_1_y2_r = hp1_1_y1_r; hp1_1_y1_r = y;
  x = y;
  y = hp1_b0*x + hp1_b1*hp1_2_x1_r + hp1_b2*hp1_2_x2_r - hp1_a1*hp1_2_y1_r - hp1_a2*hp1_2_y2_r + 10^-24;
  hp1_2_x2_r = hp1_2_x1_r; hp1_2_x1_r = x; hp1_2_y2_r = hp1_2_y1_r; hp1_2_y1_r = y;
  hi1_r = y;

  x = hi1_r;
  y = lp2_b0*x + lp2_b1*lp2_1_x1_r + lp2_b2*lp2_1_x2_r - lp2_a1*lp2_1_y1_r - lp2_a2*lp2_1_y2_r + 10^-24;
  lp2_1_x2_r = lp2_1_x1_r; lp2_1_x1_r = x; lp2_1_y2_r = lp2_1_y1_r; lp2_1_y1_r = y;
  x = y;
  y = lp2_b0*x + lp2_b1*lp2_2_x1_r + lp2_b2*lp2_2_x2_r - lp2_a1*lp2_2_y1_r - lp2_a2*lp2_2_y2_r + 10^-24;
  lp2_2_x2_r = lp2_2_x1_r; lp2_2_x1_r = x; lp2_2_y2_r = lp2_2_y1_r; lp2_2_y1_r = y;
  mid_r = y;

  x = hi1_r;
  y = hp2_b0*x + hp2_b1*hp2_1_x1_r + hp2_b2*hp2_1_x2_r - hp2_a1*hp2_1_y1_r - hp2_a2*hp2_1_y2_r + 10^-24;
  hp2_1_x2_r = hp2_1_x1_r; hp2_1_x1_r = x; hp2_1_y2_r = hp2_1_y1_r; hp2_1_y1_r = y;
  x = y;
  y = hp2_b0*x + hp2_b1*hp2_2_x1_r + hp2_b2*hp2_2_x2_r - hp2_a1*hp2_2_y1_r - hp2_a2*hp2_2_y2_r + 10^-24;
  hp2_2_x2_r = hp2_2_x1_r; hp2_2_x1_r = x; hp2_2_y2_r = hp2_2_y1_r; hp2_2_y1_r = y;
