@gfx 240 980
// DPI support for Retina macOS / HiDPI Windows
scale_retina = max(gfx_ext_retina, 1.0);
scale_w = (gfx_w / 240) * scale_retina;
scale_h = (gfx_h / 980) * scale_retina;
scale = min(scale_w, scale_h);
scale = min(max(scale, 0.45), 2.0); // Clamp scale
ui_scale = scale;

compact_mode = gfx_w < 300;
scale_font_w = (gfx_w / 380) * scale_retina;
scale_font_h = (gfx_h / 520) * scale_retina;
scale_font = min(scale_font_w, scale_font_h);
scale_font = min(max(scale_font, 0.45), 2.0);

f_sz_small = max(11, floor(11 * scale_font));
f_sz_norm = max(13, floor(13 * scale_font));
f_sz_title = max(15, floor(16 * scale_font));
compact_mode ? (
  scale_font >= 0.55 ? (
    f_sz_meter = max(18, floor(20 * scale_font));
    f_sz_norm = max(15, floor(15 * scale_font));
    f_sz_small = max(13, floor(13 * scale_font));
  ) : (
    f_sz_meter = max(10, floor(11 * (scale_font / 0.45)));
  );
) : (
  f_sz_meter = max(12, floor(16 * scale_font));
);

gfx_r=c_bg_r; gfx_g=c_bg_g; gfx_b=c_bg_b; gfx_a=1;
gfx_rect(0, 0, gfx_w, gfx_h);

ui_click_l_raw = (mouse_cap&1) && !(last_mouse_cap&1);
ui_click_r_raw = (mouse_cap&2) && !(last_mouse_cap&2);

ui_block_clicks && ((mouse_cap&3) == 0) ? ui_block_clicks = 0;
(menu_open || menu_ignore_click || menu_trigger) ? ui_block_clicks = 1;

ui_click_l = ui_block_clicks ? 0 : ui_click_l_raw;
ui_click_r = ui_block_clicks ? 0 : ui_click_r_raw;

// Title
gfx_r=c_header_r; gfx_g=c_header_g; gfx_b=c_header_b; gfx_a=1;
header_h = max(20, floor(26 * scale));
gfx_rect(0, 0, gfx_w, header_h);
gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=0.92;
gfx_setfont(1, #font_ui, f_sz_title);
gfx_measurestr("Floop Master Control (Modular)", tw, th);
gfx_x = (gfx_w - tw)/2; gfx_y = (header_h - th)/2;
gfx_drawstr("Floop Master Control (Modular)");

// C Button (Toggle Sliders)
btn_w = max(18, floor(22 * scale));
btn_h = max(16, floor(20 * scale));
btn_x = gfx_w - floor(8 * scale) - btn_w;
btn_y = (header_h - btn_h)/2;

// Button Hover/Click logic
hover_c = mouse_x >= btn_x && mouse_x < btn_x+btn_w && mouse_y >= btn_y && mouse_y < btn_y+btn_h;
down_c = hover_c && (mouse_cap&1);
hover_c && ui_click_l ? (
  sliders_showing = slider_show(UI_SLIDER_MASK, -1) > 0;
);

// Draw C Button
gfx_r=0.06; gfx_g=0.06; gfx_b=0.07; gfx_a=1;
gfx_rect(btn_x, btn_y, btn_w, btn_h);
sliders_showing ? (
  down_c ? (gfx_r=0.14; gfx_g=0.62; gfx_b=0.32;) : hover_c ? (gfx_r=0.20; gfx_g=0.84; gfx_b=0.44;) : (gfx_r=0.17; gfx_g=0.75; gfx_b=0.40;);
) : (
  down_c ? (gfx_r=0.16; gfx_g=0.16; gfx_b=0.18;) : hover_c ? (gfx_r=0.24; gfx_g=0.24; gfx_b=0.26;) : (gfx_r=0.20; gfx_g=0.20; gfx_b=0.22;);
);
gfx_rect(btn_x+1, btn_y+1, btn_w-2, btn_h-2);
sliders_showing ? (gfx_r=0.98; gfx_g=0.98; gfx_b=0.98; gfx_a=0.95;) : (gfx_r=0.9; gfx_g=0.9; gfx_b=0.9; gfx_a=0.85;);
gfx_setfont(1, #font_ui, f_sz_norm);
gfx_measurestr("C", cw, ch);
gfx_x = btn_x + (btn_w - cw)/2; gfx_y = btn_y + (btn_h - ch)/2;
gfx_drawstr("C");

active_slots = 0;
active_slot1_type > 0 ? active_slots += 1;
active_slot2_type > 0 ? active_slots += 1;
active_slot3_type > 0 ? active_slots += 1;
active_slot4_type > 0 ? active_slots += 1;
active_slot5_type > 0 ? active_slots += 1;
active_slot6_type > 0 ? active_slots += 1;
active_slot7_type > 0 ? active_slots += 1;
active_slot8_type > 0 ? active_slots += 1;
active_slot9_type > 0 ? active_slots += 1;

avail_h = gfx_h - header_h - floor(10*scale);

function DrawSlotHeader(x, y, w, h, slot_id, type) (
  gfx_r=c_slot_r; gfx_g=c_slot_g; gfx_b=c_slot_b; gfx_a=1;
  gfx_rect(x, y, w, h);
  gfx_r=c_slot_edge_r; gfx_g=c_slot_edge_g; gfx_b=c_slot_edge_b; gfx_a=1;
  gfx_rect(x, y, w, h, 0); // Outline
  
  gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=0.70;
  gfx_setfont(1, #font_ui, f_sz_norm);
  sprintf(#slot_txt, "SLOT %d %s", slot_id, type == 0 ? "(Empty)" : type == 1 ? "- TP & LUFS METER" : type == 2 ? "- SPECTRUM ANALYZER" : type == 3 ? "- PHASE CORRELATION" : type == 4 ? "- MULTI-BAND PHASE" : type == 5 ? "- STEREO ANALYZER" : type == 6 ? "- OSCILLOSCOPE" : type == 7 ? "- MONITOR CONTROL" : type == 8 ? "- VU METER" : "- SPECTROGRAM");
  gfx_x = x + floor(8*scale); gfx_y = y + floor(6*scale);
  gfx_drawstr(#slot_txt);
  
  // + Button for menu
  btn_w = max(18, floor(22 * scale));
  btn_h = max(16, floor(20 * scale));
  btn_x = x + w - btn_w - floor(6*scale);
  btn_y = y + (h - btn_h)/2;
  
  hover = mouse_x >= btn_x && mouse_x < btn_x+btn_w && mouse_y >= btn_y && mouse_y < btn_y+btn_h;
  down = hover && (mouse_cap&1);
  
  gfx_r=0.06; gfx_g=0.06; gfx_b=0.07; gfx_a=1;
  gfx_rect(btn_x, btn_y, btn_w, btn_h);
  down ? (gfx_r=0.16; gfx_g=0.16; gfx_b=0.18;) : hover ? (gfx_r=0.24; gfx_g=0.24; gfx_b=0.26;) : (gfx_r=0.20; gfx_g=0.20; gfx_b=0.22;);
  gfx_rect(btn_x+1, btn_y+1, btn_w-2, btn_h-2);
  
  gfx_r=0.9; gfx_g=0.9; gfx_b=0.9; gfx_a=0.85;
  gfx_setfont(1, #font_ui, f_sz_norm);
  gfx_measurestr("+", tw, th);
  gfx_x = btn_x + (btn_w - tw)/2; gfx_y = btn_y + (btn_h - th)/2;
  gfx_drawstr("+");
  
  hover && ui_click_l ? (
    ui_block_clicks = 1; ui_click_l = 0; ui_click_r = 0;
    menu_open && menu_open_slot == slot_id ? (
      menu_open = 0;
      menu_ignore_click = 0;
      menu_trigger = 0;
    ) : (
      menu_open_slot = slot_id;
      menu_anchor_x = btn_x;
      menu_anchor_y = btn_y + btn_h;
      menu_trigger = 1;
    );
  );
);

active_slots > 0 ? (
  // Se ci sono slot vuoti in mezzo, permetti di aggiungerne un altro alla fine se < 9
  add_btn_h = (active_slots < 9) ? floor(24 * scale) : 0;
  
  header_bar_h = max(20, floor(22 * scale));
  slot_h = floor((avail_h - add_btn_h) / active_slots);
  embedded_narrow = (gfx_w / max(scale_retina, 1.0)) < 320;
  (embedded_narrow && active_slots == 1) ? (
    slot_h_cap = floor(((980 - 26 - 10 - 24) / 7) * scale);
    slot_h_min = header_bar_h + floor(70 * scale) + 5;
    slot_h_cap < slot_h_min ? slot_h_cap = slot_h_min;
    slot_h > slot_h_cap ? slot_h = slot_h_cap;
  );
  curr_y = header_h + floor(5*scale);
  min_slot_body_h = max(1, floor(24 * scale));
  
  // Render slots sequentially
  active_slot1_type > 0 ? (
    DrawSlotHeader(5, curr_y, gfx_w-10, header_bar_h, 1, active_slot1_type);
    slot_body_y = curr_y + header_bar_h;
    slot_body_h = max(0, slot_h - header_bar_h - 5);
    slot_body_h >= min_slot_body_h ? (
      active_slot1_type == 1 ? slot1_m1.mod_meter_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot1_type == 2 ? slot1_m2.mod_spectrum_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot1_type == 3 ? slot1_m3.mod_phase_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot1_type == 4 ? slot1_m4.mod_correlometer_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot1_type == 5 ? slot1_m5.mod_stereo_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot1_type == 6 ? slot1_m6.mod_oscilloscope_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot1_type == 7 ? slot1_m7.mod_monitor_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot1_type == 8 ? slot1_m8.mod_vumeter_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot1_type == 9 ? slot1_m9.mod_spectrogram_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale);
