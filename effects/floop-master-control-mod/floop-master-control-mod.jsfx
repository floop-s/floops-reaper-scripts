gain = 10 ^ (out_gain_db / 20);
dim_active ? gain *= 10 ^ (dim_db / 20);

xover_srate != srate ? (
  xover_srate = srate;
  band_xfade_a = exp(-1 / max(1, (0.01 * srate)));
  band_xfade_b = 1 - band_xfade_a;
