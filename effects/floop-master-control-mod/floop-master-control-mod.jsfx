    DrawSlotHeader(5, curr_y, gfx_w-10, header_bar_h, 7, active_slot7_type);
    slot_body_y = curr_y + header_bar_h;
    slot_body_h = max(0, slot_h - header_bar_h - 5);
    slot_body_h >= min_slot_body_h ? (
      active_slot7_type == 1 ? slot7_m1.mod_meter_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot7_type == 2 ? slot7_m2.mod_spectrum_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot7_type == 3 ? slot7_m3.mod_phase_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot7_type == 4 ? slot7_m4.mod_correlometer_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot7_type == 5 ? slot7_m5.mod_stereo_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot7_type == 6 ? slot7_m6.mod_oscilloscope_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot7_type == 7 ? slot7_m7.mod_monitor_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot7_type == 8 ? slot7_m8.mod_vumeter_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot7_type == 9 ? slot7_m9.mod_spectrogram_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale);
    );
    curr_y += slot_h;
  );
  active_slot8_type > 0 ? (
    DrawSlotHeader(5, curr_y, gfx_w-10, header_bar_h, 8, active_slot8_type);
    slot_body_y = curr_y + header_bar_h;
    slot_body_h = max(0, slot_h - header_bar_h - 5);
    slot_body_h >= min_slot_body_h ? (
      active_slot8_type == 1 ? slot8_m1.mod_meter_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot8_type == 2 ? slot8_m2.mod_spectrum_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot8_type == 3 ? slot8_m3.mod_phase_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot8_type == 4 ? slot8_m4.mod_correlometer_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot8_type == 5 ? slot8_m5.mod_stereo_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot8_type == 6 ? slot8_m6.mod_oscilloscope_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot8_type == 7 ? slot8_m7.mod_monitor_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot8_type == 8 ? slot8_m8.mod_vumeter_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot8_type == 9 ? slot8_m9.mod_spectrogram_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale);
    );
    curr_y += slot_h;
  );
  active_slot9_type > 0 ? (
    DrawSlotHeader(5, curr_y, gfx_w-10, header_bar_h, 9, active_slot9_type);
    slot_body_y = curr_y + header_bar_h;
    slot_body_h = max(0, slot_h - header_bar_h - 5);
    slot_body_h >= min_slot_body_h ? (
      active_slot9_type == 1 ? slot9_m1.mod_meter_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot9_type == 2 ? slot9_m2.mod_spectrum_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot9_type == 3 ? slot9_m3.mod_phase_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot9_type == 4 ? slot9_m4.mod_correlometer_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot9_type == 5 ? slot9_m5.mod_stereo_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot9_type == 6 ? slot9_m6.mod_oscilloscope_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot9_type == 7 ? slot9_m7.mod_monitor_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot9_type == 8 ? slot9_m8.mod_vumeter_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale) : active_slot9_type == 9 ? slot9_m9.mod_spectrogram_gfx(5, slot_body_y, gfx_w-10, slot_body_h, scale);
    );
    curr_y += slot_h;
  );
  
  // Add Module Button at the bottom
  active_slots < 9 ? (
    btn_w = gfx_w - 10;
    btn_x = 5;
    btn_y = curr_y + floor(2*scale);
    
    hover = mouse_x >= btn_x && mouse_x < btn_x+btn_w && mouse_y >= btn_y && mouse_y < btn_y+add_btn_h;
    down = hover && (mouse_cap&1);
    
    gfx_r=0.06; gfx_g=0.06; gfx_b=0.07; gfx_a=1;
    gfx_rect(btn_x, btn_y, btn_w, add_btn_h);
    down ? (gfx_r=0.16; gfx_g=0.16; gfx_b=0.18;) : hover ? (gfx_r=0.24; gfx_g=0.24; gfx_b=0.26;) : (gfx_r=0.20; gfx_g=0.20; gfx_b=0.22;);
    gfx_rect(btn_x+1, btn_y+1, btn_w-2, add_btn_h-2);
    
    gfx_r=0.9; gfx_g=0.9; gfx_b=0.9; gfx_a=0.85;
    gfx_setfont(1, #font_ui, f_sz_norm);
    gfx_measurestr("+ ADD MODULE", tw, th);
    gfx_x = btn_x + (btn_w - tw)/2; gfx_y = btn_y + (add_btn_h - th)/2;
    gfx_drawstr("+ ADD MODULE");
    
    hover && ui_click_l ? (
      ui_block_clicks = 1; ui_click_l = 0; ui_click_r = 0;
      // Find first empty slot
      target_slot = 0;
      active_slot1_type == 0 ? target_slot = 1 :
      active_slot2_type == 0 ? target_slot = 2 :
      active_slot3_type == 0 ? target_slot = 3 :
      active_slot4_type == 0 ? target_slot = 4 :
      active_slot5_type == 0 ? target_slot = 5 :
      active_slot6_type == 0 ? target_slot = 6 :
      active_slot7_type == 0 ? target_slot = 7 :
      active_slot8_type == 0 ? target_slot = 8 :
      active_slot9_type == 0 ? target_slot = 9;
      
      target_slot > 0 ? (
        menu_open && menu_open_slot == target_slot ? (
          menu_open = 0;
          menu_ignore_click = 0;
          menu_trigger = 0;
        ) : (
          menu_open_slot = target_slot;
          menu_anchor_x = btn_x;
          menu_anchor_y = btn_y + add_btn_h;
          menu_trigger = 1;
        );
      );
    );
  );

) : (
  gfx_x = (gfx_w - tw)/2; gfx_y = gfx_h/2;
  gfx_r=0.5; gfx_g=0.5; gfx_b=0.5;
  gfx_drawstr("No modules loaded. Click '+' to configure.");
  
  // Big + button in the center when empty
  btn_w = max(40, floor(40 * scale));
  btn_x = (gfx_w - btn_w)/2;
  btn_y = gfx_y + floor(20 * scale);
  
  hover = mouse_x >= btn_x && mouse_x < btn_x+btn_w && mouse_y >= btn_y && mouse_y < btn_y+btn_w;
  gfx_r=0.3; gfx_g=0.3; gfx_b=0.35;
  hover ? (gfx_r=0.4; gfx_g=0.4; gfx_b=0.45;);
  gfx_rect(btn_x, btn_y, btn_w, btn_w);
  gfx_r=1; gfx_g=1; gfx_b=1; gfx_a=1;
  gfx_setfont(1, #font_ui, max(20, floor(24 * scale)));
  gfx_measurestr("+", tw, th);
  gfx_x = btn_x + (btn_w - tw)/2; gfx_y = btn_y + (btn_w - th)/2;
  gfx_drawstr("+");
  
  hover && ui_click_l ? (
    ui_block_clicks = 1; ui_click_l = 0; ui_click_r = 0;
    menu_open && menu_open_slot == 1 ? (
      menu_open = 0;
      menu_ignore_click = 0;
      menu_trigger = 0;
    ) : (
      menu_open_slot = 1;
      menu_anchor_x = btn_x;
      menu_anchor_y = btn_y + btn_w;
      menu_trigger = 1;
    );
  );
);

// Popup Menu Handling
menu_trigger ? (
  menu_open = 1;
  menu_ignore_click = 1;
  menu_trigger = 0;
);

menu_open ? (
  menu_ignore_click && !(mouse_cap&1) ? menu_ignore_click = 0;
  click_trig_raw = ui_click_l_raw;
  click_trig = click_trig_raw && !menu_ignore_click;
  item_h = max(max(16, floor(20 * scale)), floor(f_sz_norm * 1.55));
  menu_w = max(210, floor(240 * scale));
  menu_h = item_h * 10;
  mx = menu_anchor_x;
  my = menu_anchor_y;
  mx < 0 ? mx = 0;
  my < 0 ? my = 0;
  mx > gfx_w - menu_w ? mx = gfx_w - menu_w;
  my > gfx_h - menu_h ? my = gfx_h - menu_h;
  mx < 0 ? mx = 0;
  my < 0 ? my = 0;

  gfx_r=c_panel_r; gfx_g=c_panel_g; gfx_b=c_panel_b; gfx_a=0.98;
  gfx_rect(mx, my, menu_w, menu_h);
  gfx_r=c_panel_edge_r; gfx_g=c_panel_edge_g; gfx_b=c_panel_edge_b; gfx_a=1;
  gfx_rect(mx, my, menu_w, menu_h, 0);

  i = 0;
  loop(10,
    iy = my + i * item_h;
    hov = mouse_x >= mx && mouse_x < mx + menu_w && mouse_y >= iy && mouse_y < iy + item_h;
    gfx_r=c_bg_r; gfx_g=c_bg_g; gfx_b=c_bg_b; gfx_a=1;
    hov ? (gfx_r=c_slot_edge_r; gfx_g=c_slot_edge_g; gfx_b=c_slot_edge_b;) : 0;
    gfx_rect(mx+1, iy+1, menu_w-2, item_h-2);

    i == 0 ? strcpy(#mi, "Empty") :
    i == 1 ? strcpy(#mi, "True Peak & LUFS Meter") :
    i == 2 ? strcpy(#mi, "Spectrum Analyzer") :
    i == 3 ? strcpy(#mi, "Phase Correlation") :
    i == 4 ? strcpy(#mi, "Multi-band Phase") :
    i == 5 ? strcpy(#mi, "Stereo Analyzer") :
    i == 6 ? strcpy(#mi, "Oscilloscope") :
    i == 7 ? strcpy(#mi, "Monitor Control") :
    i == 8 ? strcpy(#mi, "VU Meter") :
    strcpy(#mi, "Spectrogram");

    gfx_r=0.92; gfx_g=0.92; gfx_b=0.92; gfx_a=0.85;
    gfx_setfont(1, #font_ui, f_sz_norm);
    gfx_measurestr(#mi, tw, th);
    gfx_x = mx + floor(8*scale);
    gfx_y = iy + (item_h - th) * 0.5;
    gfx_drawstr(#mi);

    hov && click_trig ? (
      type_val = i;
      menu_open_slot == 1 && slot1_type != type_val ? (slider1 = slot1_type = type_val;) :
      menu_open_slot == 2 && slot2_type != type_val ? (slider2 = slot2_type = type_val;) :
      menu_open_slot == 3 && slot3_type != type_val ? (slider3 = slot3_type = type_val;) :
      menu_open_slot == 4 && slot4_type != type_val ? (slider4 = slot4_type = type_val;) :
      menu_open_slot == 5 && slot5_type != type_val ? (slider5 = slot5_type = type_val;) :
      menu_open_slot == 6 && slot6_type != type_val ? (slider6 = slot6_type = type_val;) :
      menu_open_slot == 7 && slot7_type != type_val ? (slider7 = slot7_type = type_val;) :
      menu_open_slot == 8 && slot8_type != type_val ? (slider26 = slot8_type = type_val;) :
      menu_open_slot == 9 && slot9_type != type_val ? (slider27 = slot9_type = type_val;);
      menu_open = 0;
    );

    i += 1;
  );

  click_trig ? (
    (mouse_x < mx || mouse_x >= mx + menu_w || mouse_y < my || mouse_y >= my + menu_h) ? menu_open = 0;
  );
);

last_mouse_cap = mouse_cap;

@serialize
file_var(0, f_version);
f_version == 0 ? f_version = 1;

file_var(0, slot1_m2.view_offset_db); file_var(0, slot1_m6.scope_view_seconds); file_var(0, slot1_m6.scope_show_l); file_var(0, slot1_m6.scope_show_r); file_var(0, slot1_m8.vu_t99); file_var(0, slot1_m8.vu_os_target);
file_var(0, slot2_m2.view_offset_db); file_var(0, slot2_m6.scope_view_seconds); file_var(0, slot2_m6.scope_show_l); file_var(0, slot2_m6.scope_show_r); file_var(0, slot2_m8.vu_t99); file_var(0, slot2_m8.vu_os_target);
file_var(0, slot3_m2.view_offset_db); file_var(0, slot3_m6.scope_view_seconds); file_var(0, slot3_m6.scope_show_l); file_var(0, slot3_m6.scope_show_r); file_var(0, slot3_m8.vu_t99); file_var(0, slot3_m8.vu_os_target);
file_var(0, slot4_m2.view_offset_db); file_var(0, slot4_m6.scope_view_seconds); file_var(0, slot4_m6.scope_show_l); file_var(0, slot4_m6.scope_show_r); file_var(0, slot4_m8.vu_t99); file_var(0, slot4_m8.vu_os_target);
file_var(0, slot5_m2.view_offset_db); file_var(0, slot5_m6.scope_view_seconds); file_var(0, slot5_m6.scope_show_l); file_var(0, slot5_m6.scope_show_r); file_var(0, slot5_m8.vu_t99); file_var(0, slot5_m8.vu_os_target);
file_var(0, slot6_m2.view_offset_db); file_var(0, slot6_m6.scope_view_seconds); file_var(0, slot6_m6.scope_show_l); file_var(0, slot6_m6.scope_show_r); file_var(0, slot6_m8.vu_t99); file_var(0, slot6_m8.vu_os_target);
file_var(0, slot7_m2.view_offset_db); file_var(0, slot7_m6.scope_view_seconds); file_var(0, slot7_m6.scope_show_l); file_var(0, slot7_m6.scope_show_r); file_var(0, slot7_m8.vu_t99); file_var(0, slot7_m8.vu_os_target);
file_var(0, slot8_m2.view_offset_db); file_var(0, slot8_m6.scope_view_seconds); file_var(0, slot8_m6.scope_show_l); file_var(0, slot8_m6.scope_show_r); file_var(0, slot8_m8.vu_t99); file_var(0, slot8_m8.vu_os_target);
file_var(0, slot9_m2.view_offset_db); file_var(0, slot9_m6.scope_view_seconds); file_var(0, slot9_m6.scope_show_l); file_var(0, slot9_m6.scope_show_r); file_var(0, slot9_m8.vu_t99); file_var(0, slot9_m8.vu_os_target);
