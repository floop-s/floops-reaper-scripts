  xover2_smooth = xover2_smooth * x_fc_a + x_t2 * x_fc_b;

  (abs(xover1_smooth - xover1_coeff_fc) > 0.05 || abs(xover2_smooth - xover2_coeff_fc) > 0.05) ? (
    xover1_coeff_fc = xover1_smooth;
    xover2_coeff_fc = xover2_smooth;

    q_butt = 0.70710678;

    w0 = 2*$pi*xover1_smooth/srate;
    cw = cos(w0);
    sw = sin(w0);
    alpha = sw / (2*q_butt);
    a0 = 1 + alpha;
    inv_a0 = 1 / a0;
    a1 = (-2*cw) * inv_a0;
    a2 = (1 - alpha) * inv_a0;
    lp1_b0 = ((1 - cw) * 0.5) * inv_a0;
    lp1_b1 = (1 - cw) * inv_a0;
    lp1_b2 = lp1_b0;
    hp1_b0 = ((1 + cw) * 0.5) * inv_a0;
