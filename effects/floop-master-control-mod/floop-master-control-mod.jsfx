active_slot1_type > 0 ? ( active_slot1_type == 2 ? slot1_m2.mod_spectrum_sample(spl0, spl1) : active_slot1_type == 4 ? slot1_m4.mod_correlometer_sample(spl0, spl1) : active_slot1_type == 5 ? slot1_m5.mod_stereo_sample(spl0, spl1) : active_slot1_type == 6 ? slot1_m6.mod_oscilloscope_sample(spl0, spl1) : active_slot1_type == 7 ? slot1_m7.mod_monitor_sample(spl0, spl1) : active_slot1_type == 9 ? slot1_m9.mod_spectrogram_sample(spl0, spl1); );
