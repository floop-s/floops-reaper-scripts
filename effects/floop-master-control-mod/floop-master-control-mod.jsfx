desc:Floop Master Control (Modular)
// @version 1.0.0
// @author Floop-s
// @license GPL-3.0
// @about
//   Modular master monitoring and analysis tool for REAPER.
//
//   Slot-based workflow (up to 9 slots per instance).
//
//   Includes:
//   - True Peak and LUFS metering (Short-Term and Integrated)
//   - Spectrum analyzer (Mid/Side, temporal averaging, smoothing, hold/freeze)
//   - Phase correlation (bar) and multi-band phase
//   - Stereo goniometer
//   - Oscilloscope
//   - Spectrogram
//   - Monitor control (Dim, Solo Mid/Side, Low/Mid/High focus)
//   - VU meter
//
//   Keywords: LUFS, true peak, spectrum, spectrogram, phase, stereo, monitor, mastering.
// @provides
//   [effect] floop-master-control-mod.jsfx
//   [data] modules/mod_meter.jsfx-inc
//   [data] modules/mod_spectrum.jsfx-inc
//   [data] modules/mod_stereo.jsfx-inc
//   [data] modules/mod_phase.jsfx-inc
//   [data] modules/mod_correlometer.jsfx-inc
//   [data] modules/mod_oscilloscope.jsfx-inc
//   [data] modules/mod_monitor.jsfx-inc
//   [data] modules/mod_vumeter.jsfx-inc
//   [data] modules/mod_spectrogram.jsfx-inc

import modules/mod_meter.jsfx-inc
import modules/mod_spectrum.jsfx-inc
import modules/mod_stereo.jsfx-inc
import modules/mod_phase.jsfx-inc
import modules/mod_correlometer.jsfx-inc
import modules/mod_oscilloscope.jsfx-inc
import modules/mod_monitor.jsfx-inc
import modules/mod_vumeter.jsfx-inc
import modules/mod_spectrogram.jsfx-inc

slider1:slot1_type=1<0,9,1{Empty,True Peak / LUFS,Spectrum,Phase Correlation,Multi-band Phase,Stereo Analyzer,Oscilloscope,Monitor Control,VU Meter,Spectrogram}>Slot 1
slider2:slot2_type=2<0,9,1{Empty,True Peak / LUFS,Spectrum,Phase Correlation,Multi-band Phase,Stereo Analyzer,Oscilloscope,Monitor Control,VU Meter,Spectrogram}>Slot 2
slider3:slot3_type=5<0,9,1{Empty,True Peak / LUFS,Spectrum,Phase Correlation,Multi-band Phase,Stereo Analyzer,Oscilloscope,Monitor Control,VU Meter,Spectrogram}>Slot 3
slider4:slot4_type=3<0,9,1{Empty,True Peak / LUFS,Spectrum,Phase Correlation,Multi-band Phase,Stereo Analyzer,Oscilloscope,Monitor Control,VU Meter,Spectrogram}>Slot 4
slider5:slot5_type=6<0,9,1{Empty,True Peak / LUFS,Spectrum,Phase Correlation,Multi-band Phase,Stereo Analyzer,Oscilloscope,Monitor Control,VU Meter,Spectrogram}>Slot 5
slider6:slot6_type=7<0,9,1{Empty,True Peak / LUFS,Spectrum,Phase Correlation,Multi-band Phase,Stereo Analyzer,Oscilloscope,Monitor Control,VU Meter,Spectrogram}>Slot 6
slider7:slot7_type=0<0,9,1{Empty,True Peak / LUFS,Spectrum,Phase Correlation,Multi-band Phase,Stereo Analyzer,Oscilloscope,Monitor Control,VU Meter,Spectrogram}>Slot 7
slider26:slot8_type=0<0,9,1{Empty,True Peak / LUFS,Spectrum,Phase Correlation,Multi-band Phase,Stereo Analyzer,Oscilloscope,Monitor Control,VU Meter,Spectrogram}>Slot 8
slider27:slot9_type=0<0,9,1{Empty,True Peak / LUFS,Spectrum,Phase Correlation,Multi-band Phase,Stereo Analyzer,Oscilloscope,Monitor Control,VU Meter,Spectrogram}>Slot 9

slider8:monitor_mode=0<0,2,1{Normal,Mono,Side}>-Monitor Mode
slider9:out_gain_db=0<-60,12,0.1>Monitor Gain (dB)
slider10:dim_active=0<0,1,1>Dim
slider11:band_focus_low=0<0,1,1>Band Focus Low
slider28:band_focus_mid=0<0,1,1>Band Focus Mid
slider23:dim_db=-18<-36,0,0.1>Dim Attenuation (dB)
slider24:xover1_hz=200<40,1000,1>Band Xover 1 (Hz)
slider25:xover2_hz=2000<200,12000,1>Band Xover 2 (Hz)

slider12:tp_limit_mode=0<0,2,1{-1.0 dBTP,-0.3 dBTP,0.0 dBTP}>True Peak Threshold
slider13:lufs_s_limit_db=-14<-36,0,0.1>LUFS-S Target

slider14:spec_avg_mode=300<50,5000,1>Spectrum Temporal (ms)
slider15:spec_slope_db=4.5<0,6,0.1>Spectrum Slope (dB/oct)
slider16:spec_freeze=0<0,1,1>Spectrum Freeze
slider17:spec_smoothing_oct=1<0,2,0.01>Smoothing (Octave)
slider18:spec_mode_ms=0<0,1,1{Stereo,Mid/Side}>Spectrum Mode
slider19:band_focus_high=0<0,1,1>Band Focus High

slider22:spec_hold=0<0,1,1>Spectrum Hold
slider29:spec_show_peak=0<0,1,1>Spectrum Show Peak

slider20:vu_calib=18<10,24,1>VU Calibration (-dBFS)
slider21:spectrogram_speed=1<1,10,1>Spectrogram Speed

options:no_meter

@init
ext_noinit = 1.0;

active_slot1_type = active_slot2_type = active_slot3_type = active_slot4_type = active_slot5_type = active_slot6_type = active_slot7_type = active_slot8_type = active_slot9_type = -1;


strcpy(#font_ui, "Arial, Helvetica, sans-serif");

c_bg_r = 0.10; c_bg_g = 0.10; c_bg_b = 0.12;
c_header_r = 0.18; c_header_g = 0.18; c_header_b = 0.20;
c_slot_r = 0.14; c_slot_g = 0.14; c_slot_b = 0.16;
c_slot_edge_r = 0.22; c_slot_edge_g = 0.22; c_slot_edge_b = 0.25;
c_panel_r = 0.12; c_panel_g = 0.12; c_panel_b = 0.14;
c_panel_edge_r = 0.20; c_panel_edge_g = 0.20; c_panel_edge_b = 0.23;

UI_SLIDER_MASK = (1<<29)-1;
sliders_showing = slider_show(UI_SLIDER_MASK, 0) > 0;
ui_block_clicks = 0;

// Memory Management
mem_ptr = 10000; 

slot_mem_meter = 5000;
slot_mem_spectrum = 60000;
slot_mem_stereo = 3000;
slot_mem_phase = 2000;
slot_mem_correlometer = 60000;
slot_mem_oscilloscope = 500000;
slot_mem_monitor = 2000;
slot_mem_vumeter = 2000;
slot_mem_spectrogram = 60000;

slot_mem_size =
  slot_mem_meter +
  slot_mem_spectrum +
  slot_mem_stereo +
  slot_mem_phase +
  slot_mem_correlometer +
  slot_mem_oscilloscope +
  slot_mem_monitor +
  slot_mem_vumeter +
  slot_mem_spectrogram;

slot1_mem = mem_ptr; mem_ptr += slot_mem_size;
slot2_mem = mem_ptr; mem_ptr += slot_mem_size;
slot3_mem = mem_ptr; mem_ptr += slot_mem_size;
slot4_mem = mem_ptr; mem_ptr += slot_mem_size;
slot5_mem = mem_ptr; mem_ptr += slot_mem_size;
slot6_mem = mem_ptr; mem_ptr += slot_mem_size;
slot7_mem = mem_ptr; mem_ptr += slot_mem_size;
slot8_mem = mem_ptr; mem_ptr += slot_mem_size;
slot9_mem = mem_ptr; mem_ptr += slot_mem_size;

// Initialize Slots
p1 = slot1_mem;
slot1_m1.mod_meter_init(1, p1, slot_mem_meter); p1 += slot_mem_meter;
slot1_m2.mod_spectrum_init(1, p1, slot_mem_spectrum); p1 += slot_mem_spectrum;
slot1_m5.mod_stereo_init(1, p1, slot_mem_stereo); p1 += slot_mem_stereo;
slot1_m3.mod_phase_init(1, p1, slot_mem_phase); p1 += slot_mem_phase;
slot1_m4.mod_correlometer_init(1, p1, slot_mem_correlometer); p1 += slot_mem_correlometer;
slot1_m6.mod_oscilloscope_init(1, p1, slot_mem_oscilloscope); p1 += slot_mem_oscilloscope;
slot1_m7.mod_monitor_init(1, p1, slot_mem_monitor); p1 += slot_mem_monitor;
slot1_m8.mod_vumeter_init(1, p1, slot_mem_vumeter); p1 += slot_mem_vumeter;
slot1_m9.mod_spectrogram_init(1, p1, slot_mem_spectrogram); p1 += slot_mem_spectrogram;

p2 = slot2_mem;
slot2_m1.mod_meter_init(2, p2, slot_mem_meter); p2 += slot_mem_meter;
slot2_m2.mod_spectrum_init(2, p2, slot_mem_spectrum); p2 += slot_mem_spectrum;
slot2_m5.mod_stereo_init(2, p2, slot_mem_stereo); p2 += slot_mem_stereo;
slot2_m3.mod_phase_init(2, p2, slot_mem_phase); p2 += slot_mem_phase;
slot2_m4.mod_correlometer_init(2, p2, slot_mem_correlometer); p2 += slot_mem_correlometer;
slot2_m6.mod_oscilloscope_init(2, p2, slot_mem_oscilloscope); p2 += slot_mem_oscilloscope;
slot2_m7.mod_monitor_init(2, p2, slot_mem_monitor); p2 += slot_mem_monitor;
slot2_m8.mod_vumeter_init(2, p2, slot_mem_vumeter); p2 += slot_mem_vumeter;
slot2_m9.mod_spectrogram_init(2, p2, slot_mem_spectrogram); p2 += slot_mem_spectrogram;

p3 = slot3_mem;
slot3_m1.mod_meter_init(3, p3, slot_mem_meter); p3 += slot_mem_meter;
slot3_m2.mod_spectrum_init(3, p3, slot_mem_spectrum); p3 += slot_mem_spectrum;
slot3_m5.mod_stereo_init(3, p3, slot_mem_stereo); p3 += slot_mem_stereo;
slot3_m3.mod_phase_init(3, p3, slot_mem_phase); p3 += slot_mem_phase;
slot3_m4.mod_correlometer_init(3, p3, slot_mem_correlometer); p3 += slot_mem_correlometer;
slot3_m6.mod_oscilloscope_init(3, p3, slot_mem_oscilloscope); p3 += slot_mem_oscilloscope;
slot3_m7.mod_monitor_init(3, p3, slot_mem_monitor); p3 += slot_mem_monitor;
slot3_m8.mod_vumeter_init(3, p3, slot_mem_vumeter); p3 += slot_mem_vumeter;
slot3_m9.mod_spectrogram_init(3, p3, slot_mem_spectrogram); p3 += slot_mem_spectrogram;

p4 = slot4_mem;
slot4_m1.mod_meter_init(4, p4, slot_mem_meter); p4 += slot_mem_meter;
slot4_m2.mod_spectrum_init(4, p4, slot_mem_spectrum); p4 += slot_mem_spectrum;
slot4_m5.mod_stereo_init(4, p4, slot_mem_stereo); p4 += slot_mem_stereo;
slot4_m3.mod_phase_init(4, p4, slot_mem_phase); p4 += slot_mem_phase;
slot4_m4.mod_correlometer_init(4, p4, slot_mem_correlometer); p4 += slot_mem_correlometer;
slot4_m6.mod_oscilloscope_init(4, p4, slot_mem_oscilloscope); p4 += slot_mem_oscilloscope;
slot4_m7.mod_monitor_init(4, p4, slot_mem_monitor); p4 += slot_mem_monitor;
slot4_m8.mod_vumeter_init(4, p4, slot_mem_vumeter); p4 += slot_mem_vumeter;
slot4_m9.mod_spectrogram_init(4, p4, slot_mem_spectrogram); p4 += slot_mem_spectrogram;

p5 = slot5_mem;
slot5_m1.mod_meter_init(5, p5, slot_mem_meter); p5 += slot_mem_meter;
slot5_m2.mod_spectrum_init(5, p5, slot_mem_spectrum); p5 += slot_mem_spectrum;
slot5_m5.mod_stereo_init(5, p5, slot_mem_stereo); p5 += slot_mem_stereo;
slot5_m3.mod_phase_init(5, p5, slot_mem_phase); p5 += slot_mem_phase;
slot5_m4.mod_correlometer_init(5, p5, slot_mem_correlometer); p5 += slot_mem_correlometer;
slot5_m6.mod_oscilloscope_init(5, p5, slot_mem_oscilloscope); p5 += slot_mem_oscilloscope;
slot5_m7.mod_monitor_init(5, p5, slot_mem_monitor); p5 += slot_mem_monitor;
slot5_m8.mod_vumeter_init(5, p5, slot_mem_vumeter); p5 += slot_mem_vumeter;
slot5_m9.mod_spectrogram_init(5, p5, slot_mem_spectrogram); p5 += slot_mem_spectrogram;

p6 = slot6_mem;
slot6_m1.mod_meter_init(6, p6, slot_mem_meter); p6 += slot_mem_meter;
slot6_m2.mod_spectrum_init(6, p6, slot_mem_spectrum); p6 += slot_mem_spectrum;
slot6_m5.mod_stereo_init(6, p6, slot_mem_stereo); p6 += slot_mem_stereo;
slot6_m3.mod_phase_init(6, p6, slot_mem_phase); p6 += slot_mem_phase;
slot6_m4.mod_correlometer_init(6, p6, slot_mem_correlometer); p6 += slot_mem_correlometer;
slot6_m6.mod_oscilloscope_init(6, p6, slot_mem_oscilloscope); p6 += slot_mem_oscilloscope;
slot6_m7.mod_monitor_init(6, p6, slot_mem_monitor); p6 += slot_mem_monitor;
slot6_m8.mod_vumeter_init(6, p6, slot_mem_vumeter); p6 += slot_mem_vumeter;
slot6_m9.mod_spectrogram_init(6, p6, slot_mem_spectrogram); p6 += slot_mem_spectrogram;

p7 = slot7_mem;
slot7_m1.mod_meter_init(7, p7, slot_mem_meter); p7 += slot_mem_meter;
slot7_m2.mod_spectrum_init(7, p7, slot_mem_spectrum); p7 += slot_mem_spectrum;
slot7_m5.mod_stereo_init(7, p7, slot_mem_stereo); p7 += slot_mem_stereo;
slot7_m3.mod_phase_init(7, p7, slot_mem_phase); p7 += slot_mem_phase;
slot7_m4.mod_correlometer_init(7, p7, slot_mem_correlometer); p7 += slot_mem_correlometer;
slot7_m6.mod_oscilloscope_init(7, p7, slot_mem_oscilloscope); p7 += slot_mem_oscilloscope;
slot7_m7.mod_monitor_init(7, p7, slot_mem_monitor); p7 += slot_mem_monitor;
slot7_m8.mod_vumeter_init(7, p7, slot_mem_vumeter); p7 += slot_mem_vumeter;
slot7_m9.mod_spectrogram_init(7, p7, slot_mem_spectrogram); p7 += slot_mem_spectrogram;

p8 = slot8_mem;
slot8_m1.mod_meter_init(8, p8, slot_mem_meter); p8 += slot_mem_meter;
slot8_m2.mod_spectrum_init(8, p8, slot_mem_spectrum); p8 += slot_mem_spectrum;
slot8_m5.mod_stereo_init(8, p8, slot_mem_stereo); p8 += slot_mem_stereo;
slot8_m3.mod_phase_init(8, p8, slot_mem_phase); p8 += slot_mem_phase;
slot8_m4.mod_correlometer_init(8, p8, slot_mem_correlometer); p8 += slot_mem_correlometer;
slot8_m6.mod_oscilloscope_init(8, p8, slot_mem_oscilloscope); p8 += slot_mem_oscilloscope;
slot8_m7.mod_monitor_init(8, p8, slot_mem_monitor); p8 += slot_mem_monitor;
slot8_m8.mod_vumeter_init(8, p8, slot_mem_vumeter); p8 += slot_mem_vumeter;
slot8_m9.mod_spectrogram_init(8, p8, slot_mem_spectrogram); p8 += slot_mem_spectrogram;

p9 = slot9_mem;
slot9_m1.mod_meter_init(9, p9, slot_mem_meter); p9 += slot_mem_meter;
slot9_m2.mod_spectrum_init(9, p9, slot_mem_spectrum); p9 += slot_mem_spectrum;
slot9_m5.mod_stereo_init(9, p9, slot_mem_stereo); p9 += slot_mem_stereo;
slot9_m3.mod_phase_init(9, p9, slot_mem_phase); p9 += slot_mem_phase;
slot9_m4.mod_correlometer_init(9, p9, slot_mem_correlometer); p9 += slot_mem_correlometer;
slot9_m6.mod_oscilloscope_init(9, p9, slot_mem_oscilloscope); p9 += slot_mem_oscilloscope;
slot9_m7.mod_monitor_init(9, p9, slot_mem_monitor); p9 += slot_mem_monitor;
slot9_m8.mod_vumeter_init(9, p9, slot_mem_vumeter); p9 += slot_mem_vumeter;
slot9_m9.mod_spectrogram_init(9, p9, slot_mem_spectrogram); p9 += slot_mem_spectrogram;

// Host UI state
ui_scale = 1.0;

band_xfade = 0;
band_focus_last_lp = lp120_active;
band_focus_last_hi = mid_high_focus;
xover_srate = 0;
xover1_smooth = xover1_hz;
xover2_smooth = xover2_hz;
xover1_coeff_fc = -1;
xover2_coeff_fc = -1;
band_xfade_a = 1;
band_xfade_b = 0;

lp1_b0 = 1; lp1_b1 = 0; lp1_b2 = 0; lp1_a1 = 0; lp1_a2 = 0;
hp1_b0 = 1; hp1_b1 = 0; hp1_b2 = 0; hp1_a1 = 0; hp1_a2 = 0;
lp2_b0 = 1; lp2_b1 = 0; lp2_b2 = 0; lp2_a1 = 0; lp2_a2 = 0;
hp2_b0 = 1; hp2_b1 = 0; hp2_b2 = 0; hp2_a1 = 0; hp2_a2 = 0;

function ResetSlots() (
  active_slot1_type == 1 ? slot1_m1.mod_meter_reset() : active_slot1_type == 2 ? slot1_m2.mod_spectrum_reset() : active_slot1_type == 3 ? slot1_m3.mod_phase_reset() : active_slot1_type == 4 ? slot1_m4.mod_correlometer_reset() : active_slot1_type == 5 ? slot1_m5.mod_stereo_reset() : active_slot1_type == 6 ? slot1_m6.mod_oscilloscope_reset() : active_slot1_type == 8 ? slot1_m8.mod_vumeter_reset() : active_slot1_type == 9 ? slot1_m9.mod_spectrogram_reset();
  active_slot2_type == 1 ? slot2_m1.mod_meter_reset() : active_slot2_type == 2 ? slot2_m2.mod_spectrum_reset() : active_slot2_type == 3 ? slot2_m3.mod_phase_reset() : active_slot2_type == 4 ? slot2_m4.mod_correlometer_reset() : active_slot2_type == 5 ? slot2_m5.mod_stereo_reset() : active_slot2_type == 6 ? slot2_m6.mod_oscilloscope_reset() : active_slot2_type == 8 ? slot2_m8.mod_vumeter_reset() : active_slot2_type == 9 ? slot2_m9.mod_spectrogram_reset();
  active_slot3_type == 1 ? slot3_m1.mod_meter_reset() : active_slot3_type == 2 ? slot3_m2.mod_spectrum_reset() : active_slot3_type == 3 ? slot3_m3.mod_phase_reset() : active_slot3_type == 4 ? slot3_m4.mod_correlometer_reset() : active_slot3_type == 5 ? slot3_m5.mod_stereo_reset() : active_slot3_type == 6 ? slot3_m6.mod_oscilloscope_reset() : active_slot3_type == 8 ? slot3_m8.mod_vumeter_reset() : active_slot3_type == 9 ? slot3_m9.mod_spectrogram_reset();
  active_slot4_type == 1 ? slot4_m1.mod_meter_reset() : active_slot4_type == 2 ? slot4_m2.mod_spectrum_reset() : active_slot4_type == 3 ? slot4_m3.mod_phase_reset() : active_slot4_type == 4 ? slot4_m4.mod_correlometer_reset() : active_slot4_type == 5 ? slot4_m5.mod_stereo_reset() : active_slot4_type == 6 ? slot4_m6.mod_oscilloscope_reset() : active_slot4_type == 8 ? slot4_m8.mod_vumeter_reset() : active_slot4_type == 9 ? slot4_m9.mod_spectrogram_reset();
  active_slot5_type == 1 ? slot5_m1.mod_meter_reset() : active_slot5_type == 2 ? slot5_m2.mod_spectrum_reset() : active_slot5_type == 3 ? slot5_m3.mod_phase_reset() : active_slot5_type == 4 ? slot5_m4.mod_correlometer_reset() : active_slot5_type == 5 ? slot5_m5.mod_stereo_reset() : active_slot5_type == 6 ? slot5_m6.mod_oscilloscope_reset() : active_slot5_type == 8 ? slot5_m8.mod_vumeter_reset() : active_slot5_type == 9 ? slot5_m9.mod_spectrogram_reset();
  active_slot6_type == 1 ? slot6_m1.mod_meter_reset() : active_slot6_type == 2 ? slot6_m2.mod_spectrum_reset() : active_slot6_type == 3 ? slot6_m3.mod_phase_reset() : active_slot6_type == 4 ? slot6_m4.mod_correlometer_reset() : active_slot6_type == 5 ? slot6_m5.mod_stereo_reset() : active_slot6_type == 6 ? slot6_m6.mod_oscilloscope_reset() : active_slot6_type == 8 ? slot6_m8.mod_vumeter_reset() : active_slot6_type == 9 ? slot6_m9.mod_spectrogram_reset();
  active_slot7_type == 1 ? slot7_m1.mod_meter_reset() : active_slot7_type == 2 ? slot7_m2.mod_spectrum_reset() : active_slot7_type == 3 ? slot7_m3.mod_phase_reset() : active_slot7_type == 4 ? slot7_m4.mod_correlometer_reset() : active_slot7_type == 5 ? slot7_m5.mod_stereo_reset() : active_slot7_type == 6 ? slot7_m6.mod_oscilloscope_reset() : active_slot7_type == 8 ? slot7_m8.mod_vumeter_reset() : active_slot7_type == 9 ? slot7_m9.mod_spectrogram_reset();
  active_slot8_type == 1 ? slot8_m1.mod_meter_reset() : active_slot8_type == 2 ? slot8_m2.mod_spectrum_reset() : active_slot8_type == 3 ? slot8_m3.mod_phase_reset() : active_slot8_type == 4 ? slot8_m4.mod_correlometer_reset() : active_slot8_type == 5 ? slot8_m5.mod_stereo_reset() : active_slot8_type == 6 ? slot8_m6.mod_oscilloscope_reset() : active_slot8_type == 8 ? slot8_m8.mod_vumeter_reset() : active_slot8_type == 9 ? slot8_m9.mod_spectrogram_reset();
  active_slot9_type == 1 ? slot9_m1.mod_meter_reset() : active_slot9_type == 2 ? slot9_m2.mod_spectrum_reset() : active_slot9_type == 3 ? slot9_m3.mod_phase_reset() : active_slot9_type == 4 ? slot9_m4.mod_correlometer_reset() : active_slot9_type == 5 ? slot9_m5.mod_stereo_reset() : active_slot9_type == 6 ? slot9_m6.mod_oscilloscope_reset() : active_slot9_type == 8 ? slot9_m8.mod_vumeter_reset() : active_slot9_type == 9 ? slot9_m9.mod_spectrogram_reset();
);

@block
// --- Monitor Band Focus Mutually Exclusive Logic & Legacy Migration ---
!init_band_focus_done ? (
  (band_focus_low == 1 && band_focus_high == 1) ? (
    band_focus_mid = 1; slider28 = 1;
    band_focus_low = 0; slider11 = 0;
    band_focus_high = 0; slider19 = 0;
  );
  lp120_active = band_focus_low || band_focus_mid;
  mid_high_focus = band_focus_high || band_focus_mid;
  last_band_focus_low = band_focus_low;
  last_band_focus_mid = band_focus_mid;
  last_band_focus_high = band_focus_high;
  init_band_focus_done = 1;
);

(band_focus_low != last_band_focus_low) ? (
  band_focus_low ? (
    band_focus_mid = 0; slider28 = 0; slider_automate(1<<27);
    band_focus_high = 0; slider19 = 0; slider_automate(1<<18);
    lp120_active = 1; mid_high_focus = 0;
  ) : (
    lp120_active = 0; mid_high_focus = 0;
  );
  last_band_focus_low = band_focus_low;
  last_band_focus_mid = band_focus_mid;
  last_band_focus_high = band_focus_high;
) :
(band_focus_mid != last_band_focus_mid) ? (
  band_focus_mid ? (
    band_focus_low = 0; slider11 = 0; slider_automate(1<<10);
    band_focus_high = 0; slider19 = 0; slider_automate(1<<18);
    lp120_active = 1; mid_high_focus = 1;
  ) : (
    lp120_active = 0; mid_high_focus = 0;
  );
  last_band_focus_low = band_focus_low;
  last_band_focus_mid = band_focus_mid;
  last_band_focus_high = band_focus_high;
) :
(band_focus_high != last_band_focus_high) ? (
  band_focus_high ? (
    band_focus_low = 0; slider11 = 0; slider_automate(1<<10);
    band_focus_mid = 0; slider28 = 0; slider_automate(1<<27);
    lp120_active = 0; mid_high_focus = 1;
  ) : (
    lp120_active = 0; mid_high_focus = 0;
  );
