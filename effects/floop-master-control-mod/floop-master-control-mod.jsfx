  lp1_2_x1_r = lp1_2_x2_r = lp1_2_y1_r = lp1_2_y2_r = 0;
  hp1_1_x1_r = hp1_1_x2_r = hp1_1_y1_r = hp1_1_y2_r = 0;
  hp1_2_x1_r = hp1_2_x2_r = hp1_2_y1_r = hp1_2_y2_r = 0;
  lp2_1_x1_r = lp2_1_x2_r = lp2_1_y1_r = lp2_1_y2_r = 0;
  lp2_2_x1_r = lp2_2_x2_r = lp2_2_y1_r = lp2_2_y2_r = 0;
  hp2_1_x1_r = hp2_1_x2_r = hp2_1_y1_r = hp2_1_y2_r = 0;
  hp2_2_x1_r = hp2_2_x2_r = hp2_2_y1_r = hp2_2_y2_r = 0;
);

(lp120_active != band_focus_last_lp || mid_high_focus != band_focus_last_hi) ? (
  (band_focus_last_lp || band_focus_last_hi) && (lp120_active || mid_high_focus) ? band_xfade = 0;
  band_focus_last_lp = lp120_active;
  band_focus_last_hi = mid_high_focus;
);

band_target = (lp120_active || mid_high_focus) ? 1 : 0;

(band_target || band_xfade > 0.00001) ? (
  x_t1 = max(40, min(1000, xover1_hz));
  x_t2 = max(200, min(12000, xover2_hz));
  x_t2 < x_t1 * 1.25 ? x_t2 = x_t1 * 1.25;

